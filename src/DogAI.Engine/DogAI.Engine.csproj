    <PackageReference Include="NAudio.Core" Version="3.3.0" />
    <PackageReference Include="NAudio.WinMM" Version="3.3.0" />
    <PackageReference Include="System.Speech" Version="9.0.11" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>

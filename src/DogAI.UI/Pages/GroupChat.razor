@page "/characters/group/new"
@page "/characters/group/{ChatId:long}"
@implements IDisposable
@inject ICharacterStore CharacterStore
@inject IChatStore Store
@inject ChatService Chat
@inject AppearanceState Appearance
@inject EngineManager Engine
@inject NavigationManager Nav

<SectionContent SectionName="title">
    <div class="head-row">
        @if (_conversation.Id != 0)
        {
            <div class="head-who">
                <span class="avatar-stack" aria-hidden="true">
                    @foreach (var c in Members.Take(4))
                    {
                        <CharacterAvatar Character="c" />
                    }
                </span>
                <div class="head-text">
                    <h2>@_conversation.Title</h2>
                    <p>@(Members.Count == 0 ? "No members" : $"{Members.Count} member{(Members.Count == 1 ? "" : "s")} · {OrderNames[_conversation.TurnOrder].Short}")</p>
                </div>
            </div>
        }
        else
        {
            <div class="head-text">
                <h2>New group chat</h2>
                <p>Several characters in one scene</p>
            </div>
        }
        <ModelPicker Mode="characters" />
    </div>
</SectionContent>

<SectionContent SectionName="list"><CharacterList ActiveGroupId="@(_conversation.Id == 0 ? null : _conversation.Id)" Version="@_listVersion" /></SectionContent>

@if (!_loaded)
{
}
else if (ChatId is null)
{
    <div class="editor">
        <h3>Who is in the group?</h3>
        <p class="small">Tick two or more characters. They speak in the order you tick them when everyone answers in turn; you can change the order later.</p>
        @if (_all.Count == 0)
        {
            <p class="small">There are no characters yet. <a class="link-text" href="characters">Import or make some</a> first.</p>
        }
        <div class="persona-grid pick-grid">
            @foreach (var c in _all)
            {
                var character = c;
                var at = _picked.IndexOf(character.Id);
                <button class="persona @(at >= 0 ? "active" : "")" aria-pressed="@(at >= 0 ? "true" : "false")" @onclick="() => TogglePick(character.Id)">
                    <CharacterAvatar Character="character" />
                    <span class="li-text">
                        <span class="li-title">@character.Name</span>
                        <span class="li-sub">@(at >= 0 ? $"Speaks {Ordinal(at + 1)}" : "Not in the group")</span>
                    </span>
                </button>
            }
        </div>

        <h3>Who answers when you write?</h3>
        <div class="choice-list">
            @foreach (var (order, text) in OrderNames)
            {
                var o = order;
                <label class="check">
                    <input type="radio" name="turn-order" checked="@(_newOrder == o)" @onchange="() => _newOrder = o" />
                    <span><strong>@text.Short.</strong> <span class="small">@text.Long</span></span>
                </label>
            }
        </div>

        @if (_notice is not null)
        {
            <div class="notice bad"><span>@_notice</span><button class="btn" @onclick="() => _notice = null">Dismiss</button></div>
        }
        <div class="row">
            <button class="btn primary" disabled="@(_picked.Count < 2 || _busy)" @onclick="CreateAsync">Start the group chat</button>
            <a class="btn" href="characters">Cancel</a>
        </div>
    </div>
}
else
{
    @if (_path.Count == 0 && !Streaming)
    {
        <EmptyState IconName="characters" Title="Nobody has said anything yet">
            None of the members has a greeting. Write the first message below, or pick someone to start under the message box.
        </EmptyState>
    }
    else
    {
        <ChatThread Conversation="@_conversation" Tree="@_tree" Path="@_path" Swipes="true" Speech="true" @bind-Notice="_notice" SpeakerOf="SpeakerOf"
                    UserName="@(_persona?.Name ?? "You")" UserAvatar="@(_persona is { } p ? Format.PictureUrl("persona", p.Id, p.CreatedAt, p.Avatar) : null)" />
    }
}

@if (_conversation.Id != 0)
{
    <SectionContent SectionName="composer">
        <div class="speak-row" role="group" aria-label="Who speaks next">
            <span class="small">Next:</span>
            @foreach (var c in Members)
            {
                var character = c;
                var muted = _members.FirstOrDefault(m => m.CharacterId == character.Id)?.Muted == true;
                <button class="speak @(muted ? "muted" : "")" disabled="@(Chat.IsBusy || !Engine.IsReady)" title="@($"{character.Name} speaks now")"
                        @onclick="() => SpeakAsync(character.Id)">
                    <CharacterAvatar Character="character" /><span>@character.Name</span>
                </button>
            }
            <button class="speak" disabled="@(Chat.IsBusy || !Engine.IsReady || Members.Count == 0)" @onclick="SpeakNextAsync"
                    title="Turn order picks someone: whoever was just named, else whoever has been quiet longest">Anyone</button>
        </div>
        <ChatComposer Path="@_path" OnSend="SendAsync" Impersonate="ImpersonateAsync"
                      Placeholder="@(Members.Count == 0 ? "Add a member in the side panel first." : $"Message {Everyone}. Enter sends, Shift+Enter adds a line.")" />
    </SectionContent>

    <SectionContent SectionName="aside">
        <div class="panel">
            <h4>Members</h4>
            @for (var i = 0; i < _members.Count; i++)
            {
                var index = i;
                var member = _members[index];
                var character = _byId.GetValueOrDefault(member.CharacterId);
                if (character is null) continue;
                <div class="member @(member.Muted ? "muted" : "") @(ToneOf(character.Id) is { } tone ? $"tone-{tone}" : "")">
                    <CharacterAvatar Character="character" />
                    <span class="li-text">
                        <a class="li-title" href="characters/@character.Id" title="@($"About {character.Name}")">@character.Name</a>
                        @if (member.Muted)
                        {
                            <span class="li-sub">Muted: speaks only when picked</span>
                        }
                        else if (_conversation.TurnOrder == TurnOrder.InTurn)
                        {
                            <span class="li-sub">Speaks @Ordinal(index + 1)</span>
                        }
                    </span>
                    <span class="member-tools">
                        <button class="icon-btn" disabled="@(index == 0)" aria-label="@($"Move {character.Name} up")" title="Move up" @onclick="() => MoveAsync(index, -1)">↑</button>
                        <button class="icon-btn" disabled="@(index == _members.Count - 1)" aria-label="@($"Move {character.Name} down")" title="Move down" @onclick="() => MoveAsync(index, 1)">↓</button>
                        <button class="icon-btn" aria-pressed="@(member.Muted ? "true" : "false")" aria-label="@(member.Muted ? $"Unmute {character.Name}" : $"Mute {character.Name}")"
                                title="@(member.Muted ? "Unmute: answer on their own again" : "Mute: speak only when picked")" @onclick="() => ToggleMuteAsync(index)">@(member.Muted ? "Unmute" : "Mute")</button>
                        <button class="icon-btn" disabled="@(_members.Count <= 1)" aria-label="@($"Remove {character.Name} from the group")" title="Remove from the group" @onclick="() => RemoveAsync(index)">✕</button>
                    </span>
                </div>
            }
            @if (Addable.Count > 0)
            {
                <div class="row">
                    <select class="field" aria-label="Character to add" @bind="_addId">
                        <option value="0">Add a character…</option>
                        @foreach (var c in Addable)
                        {
                            <option value="@c.Id">@c.Name</option>
                        }
                    </select>
                    <button class="btn" disabled="@(_addId == 0)" @onclick="AddAsync">Add</button>
                </div>
            }
            <p class="small">Removing someone keeps what they already said in the chat.</p>
        </div>
        <div class="panel">
            <h4>Turn order</h4>
            <select class="field" aria-label="Turn order" value="@((int)_conversation.TurnOrder)" @onchange="SetOrderAsync">
                @foreach (var (order, text) in OrderNames)
                {
                    <option value="@((int)order)">@text.Short</option>
                }
            </select>
            <p class="small">@OrderNames[_conversation.TurnOrder].Long</p>
        </div>
        <RoleplayPanels Conversation="@_conversation" Path="@_path" Personas="@_personas" Persona="@_persona" PersonaChanged="p => _persona = p"
                        CharacterName="@Everyone" Group="true" Streaming="@Streaming" />
        <div class="panel">
            <h4>This chat</h4>
            <input class="field" aria-label="Chat name" value="@_conversation.Title" @onchange="RenameAsync" />
            <div class="row">
                <button class="btn" disabled="@(_busy || Members.Count == 0)" @onclick="RestartAsync" title="A fresh chat with the same members">New chat</button>
                @if (_confirmDelete)
                {
                    <button class="btn danger" @onclick="DeleteChatAsync">Yes, delete it</button>
                    <button class="btn" @onclick="() => _confirmDelete = false">Keep</button>
                }
                else
                {
                    <button class="btn" @onclick="() => _confirmDelete = true">Delete chat</button>
                }
            </div>
        </div>
    </SectionContent>
}

@code {
    [Parameter] public long? ChatId { get; set; }

    private static readonly Dictionary<TurnOrder, (string Short, string Long)> OrderNames = new()
    {
        [TurnOrder.Natural] = ("Natural", "Whoever your message names answers. If you name nobody, whoever has been quiet longest does."),
        [TurnOrder.InTurn] = ("Everyone in turn", "Every member who is not muted answers once, in list order. Stop ends the round."),
        [TurnOrder.Manual] = ("You choose", "Nobody answers on their own. Pick who speaks under the message box."),
    };

    private List<Character> _all = [];
    private Dictionary<long, Character> _byId = [];
    private List<ChatMember> _members = [];
    private Conversation _conversation = new();
    private MessageTree _tree = new([]);
    private IReadOnlyList<ChatMessage> _path = [];
    private List<Persona> _personas = [];
    private Persona? _persona;
    private bool _loaded;
    private int _loadVersion;
    private int _listVersion;
    private bool _busy;
    private bool _confirmDelete;
    private string? _notice;
    private ActiveReply? _seenActive;
    private long _addId;

    // The new-group form.
    private readonly List<long> _picked = [];
    private TurnOrder _newOrder = TurnOrder.Natural;

    private List<Character> Members => _members.Select(m => _byId.GetValueOrDefault(m.CharacterId)).OfType<Character>().ToList();
    private List<Character> Addable => _all.Where(c => _members.All(m => m.CharacterId != c.Id)).ToList();
    private string Everyone => GroupTurns.JoinNames(Members.Select(c => c.Name).ToList());
    private bool Streaming => Chat.Active is { } a && a.ConversationId == _conversation.Id && _conversation.Id != 0;

    private SpeakerInfo SpeakerOf(long? id) => id is { } known && _byId.TryGetValue(known, out var c)
        ? new SpeakerInfo(c.Name, Format.PictureUrl("character", c.Id, c.UpdatedAt, c.Avatar), ToneOf(known))
        : new SpeakerInfo("Removed character", null);

    /// <summary>A member's speaker colour. It follows the order the characters were made, not the speaking order,
    /// so moving members up and down never changes anyone's colour.</summary>
    private int? ToneOf(long characterId) => Appearance.SpeechColours ? SpeakerTones.Of(_members.Select(m => m.CharacterId), characterId) : null;

    protected override void OnInitialized()
    {
        Chat.Changed += OnChatChanged;
        Engine.Changed += OnEngineChanged;
        _seenActive = Chat.Active;
    }

    protected override async Task OnParametersSetAsync()
    {
        _confirmDelete = false;
        _notice = null;
        _picked.Clear();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        var version = ++_loadVersion;
        Conversation? conversation = null;
        IReadOnlyList<ChatMessage> messages = [];
        IReadOnlyList<ChatMember> members = [];
        if (ChatId is { } chatId)
        {
            conversation = await Store.GetAsync(chatId);
            if (conversation is not { IsGroup: true })
            {
                Nav.NavigateTo("characters", replace: true);
                return;
            }
            messages = await Store.GetMessagesAsync(chatId);
            members = await Store.GetMembersAsync(chatId);
        }
        var all = (await CharacterStore.ListAsync()).OrderBy(c => c.Name, StringComparer.CurrentCultureIgnoreCase).ToList();
        var personas = (await CharacterStore.ListPersonasAsync()).ToList();
        if (version != _loadVersion) return;

        _all = all;
        _byId = all.ToDictionary(c => c.Id);
        _members = members.ToList();
        _personas = personas;
        _conversation = conversation ?? new Conversation();
        _persona = personas.FirstOrDefault(p => p.Id == _conversation.PersonaId) ?? personas.FirstOrDefault(p => p.IsDefault) ?? personas.FirstOrDefault();
        _tree = new MessageTree(messages);
        _path = _tree.PathTo(_tree.ResolveLeaf(_conversation.ActiveLeafId));
        _loaded = true;
    }

    private void OnEngineChanged() => InvokeAsync(StateHasChanged);

    private void OnChatChanged() => InvokeAsync(async () =>
    {
        var active = Chat.Active;
        if (active is null || !ReferenceEquals(active, _seenActive))
        {
            _seenActive = active;
            await LoadAsync();
        }
        StateHasChanged();
    });

    private void TogglePick(long id)
    {
        if (!_picked.Remove(id)) _picked.Add(id);
    }

    private async Task CreateAsync() => await StartAsync(_picked.ToList(), null, _newOrder);

    private async Task RestartAsync() => await StartAsync(_members.Select(m => m.CharacterId).ToList(), _conversation.PersonaId, _conversation.TurnOrder);

    private async Task StartAsync(List<long> ids, long? personaId, TurnOrder order)
    {
        _busy = true;
        _notice = null;
        try
        {
            var chat = await Chat.StartGroupChatAsync(ids, personaId, order);
            // Keep who is muted when starting over with the same members.
            if (_conversation.Id != 0 && _members.Any(m => m.Muted))
                await Store.SetMembersAsync(chat.Id, _members.Select(m => new ChatMember { CharacterId = m.CharacterId, Muted = m.Muted }).ToList());
            _listVersion++;
            Nav.NavigateTo($"characters/group/{chat.Id}");
        }
        catch (InvalidOperationException e)
        {
            _notice = e.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task Run(Func<Task> action)
    {
        if (_conversation.Id == 0) return;
        _notice = null;
        try
        {
            await action();
        }
        catch (Exception e) when (e is InvalidOperationException or EngineException)
        {
            _notice = e.Message;
        }
    }

    private Task SendAsync(string text) => Run(() => Chat.SendAsync(_conversation.Id, text));
    private Task SpeakAsync(long characterId) => Run(() => Chat.SpeakAsync(_conversation.Id, characterId));
    private Task SpeakNextAsync() => Run(() => Chat.SpeakNextAsync(_conversation.Id));

    private async Task<string> ImpersonateAsync()
    {
        var draft = "";
        await Run(async () => draft = await Chat.ImpersonateAsync(_conversation.Id));
        return draft;
    }

    private async Task SaveMembersAsync()
    {
        await Store.SetMembersAsync(_conversation.Id, _members.Select(m => new ChatMember { CharacterId = m.CharacterId, Muted = m.Muted }).ToList());
        _members = (await Store.GetMembersAsync(_conversation.Id)).ToList();
        _listVersion++;
    }

    private async Task MoveAsync(int index, int by)
    {
        var to = index + by;
        if (to < 0 || to >= _members.Count) return;
        (_members[index], _members[to]) = (_members[to], _members[index]);
        await SaveMembersAsync();
    }

    private async Task ToggleMuteAsync(int index)
    {
        _members[index].Muted = !_members[index].Muted;
        await SaveMembersAsync();
    }

    private async Task RemoveAsync(int index)
    {
        if (_members.Count <= 1) return;
        _members.RemoveAt(index);
        await SaveMembersAsync();
    }

    private async Task AddAsync()
    {
        if (_addId == 0 || _members.Any(m => m.CharacterId == _addId)) return;
        _members.Add(new ChatMember { CharacterId = _addId });
        _addId = 0;
        await SaveMembersAsync();
    }

    private async Task SetOrderAsync(ChangeEventArgs e)
    {
        if (!int.TryParse(e.Value?.ToString(), out var value) || !Enum.IsDefined((TurnOrder)value)) return;
        _conversation.TurnOrder = (TurnOrder)value;
        await Store.UpdateAsync(_conversation);
    }

    private async Task RenameAsync(ChangeEventArgs e)
    {
        var title = (e.Value?.ToString() ?? "").Trim();
        if (title.Length == 0) return;
        _conversation.Title = title;
        await Store.UpdateAsync(_conversation);
        _listVersion++;
    }

    private async Task DeleteChatAsync()
    {
        if (Streaming || Chat.IsBusy && Chat.Active?.ConversationId == _conversation.Id) Chat.Stop();
        await Store.DeleteAsync(_conversation.Id);
        _conversation = new Conversation();
        _listVersion++;
        Nav.NavigateTo("characters");
    }

    private static string Ordinal(int n) => n switch
    {
        1 => "first",
        2 => "second",
        3 => "third",
        4 => "fourth",
        5 => "fifth",
        _ => $"{n}th",
    };

    public void Dispose()
    {
        Chat.Changed -= OnChatChanged;
        Engine.Changed -= OnEngineChanged;
    }
}

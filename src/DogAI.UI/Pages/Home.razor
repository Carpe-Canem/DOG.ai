@page "/"
@implements IDisposable
@inject AppearanceState Appearance
@inject NavigationManager Nav
@inject EngineManager Engine

@* Only Playhouse has a home screen. The other skins open straight into General. *@
@if (Appearance.Skin == Skins.Playhouse)
{
    <div class="home-inner">
        <h1>@Greeting</h1>
        <p class="sub" id="home-model">@ModelLine</p>
        <div class="tiles">
            @foreach (var mode in Modes.All)
            {
                <a class="tile" href="@mode.Id" style="--tc:var(--c-@mode.Id)">
                    <Icon Name="@mode.Id" Size="34" />
                    <h3>@mode.Headline</h3>
                    <p>@mode.Blurb</p>
                </a>
            }
        </div>
    </div>
}

@code {
    private static string Greeting
    {
        get
        {
            var hour = DateTime.Now.Hour;
            if (hour >= 18) return "Good evening.";
            if (hour >= 12) return "Good afternoon.";
            if (hour >= 5) return "Good morning.";
            return "Up late.";
        }
    }

    /// <summary>What the home screen says about the chat model: the truth as it is now, not a fixed line.</summary>
    private string ModelLine => Engine.State switch
    {
        EngineState.Loading => $"Loading {Engine.ModelName}…",
        EngineState.Ready or EngineState.Resting => $"{Engine.ModelName} is ready.",
        _ => "No model is loaded yet. A mode loads its default model when you open it; get models in Models.",
    };

    private void OnEngineChanged() => InvokeAsync(StateHasChanged);

    protected override void OnInitialized()
    {
        Appearance.Changed += OnAppearanceChanged;
        Engine.Changed += OnEngineChanged;
        RedirectIfNoHome();
    }

    private void OnAppearanceChanged() => InvokeAsync(RedirectIfNoHome);

    private void RedirectIfNoHome()
    {
        if (Appearance.Skin != Skins.Playhouse)
            Nav.NavigateTo("general", replace: true);
    }

    public void Dispose()
    {
        Appearance.Changed -= OnAppearanceChanged;
        Engine.Changed -= OnEngineChanged;
    }
}

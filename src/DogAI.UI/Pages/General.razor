@page "/general"
@page "/general/{ChatId:long}"
@implements IAsyncDisposable
@inject IChatStore Store
@inject ChatService Chat
@inject EngineManager Engine
@inject IDesktopShell Desktop
@inject NavigationManager Nav
@inject IJSRuntime JS

<SectionContent SectionName="title">
    <div class="head-row">
        <div class="head-text">
            <h2>@(_conversation.Id == 0 ? "General" : _conversation.Title)</h2>
            <p>Questions, code and writing</p>
        </div>
        <ModelPicker />
    </div>
</SectionContent>

<SectionContent SectionName="list">
    <div class="list-head"><h3>Chats</h3><a class="btn" href="general">New chat</a></div>
    @foreach (var chat in _chats)
    {
        <a class="li @(chat.Id == _conversation.Id ? "active" : "")" href="general/@chat.Id">
            <span class="li-text">
                <span class="li-title">@chat.Title</span>
                <span class="li-sub">@When(chat.UpdatedAt)</span>
            </span>
        </a>
    }
    @if (_chats.Count == 0)
    {
        <p class="list-note">No chats yet.</p>
    }
</SectionContent>

@if (Visible.Count == 0 && Streaming is null)
{
    @if (Engine.IsReady)
    {
        <EmptyState IconName="general" Title="Ask anything">
            Type below to start. Everything stays on this PC.
        </EmptyState>
    }
    else
    {
        <div class="empty">
            <Icon Name="general" Size="40" />
            <h3>Load a model to start</h3>
            <p>DOG AI needs a model file on this PC before it can answer.</p>
            <ModelPicker Primary="true" />
        </div>
    }
}
else
{
    <div class="thread">
        @foreach (var message in Visible)
        {
            var m = message;
            var siblings = _tree.Siblings(m);
            var position = IndexOf(siblings, m);
            var isUser = m.Role == ChatRole.User;
            var isLast = ReferenceEquals(m, Visible[^1]);
            <MessageView IsUser="@isUser" Name="@(isUser ? "You" : m.ModelName ?? "Model")" Content="@m.Content" Reasoning="@m.Reasoning"
                         Editor="@(_editingId == m.Id ? EditBox(m) : null)">
                <Actions>
                    @if (_editingId != m.Id)
                    {
                        @if (siblings.Count > 1)
                        {
                            <span class="branch-nav">
                                <button disabled="@(Chat.IsBusy || position == 0)" aria-label="Previous version" @onclick="() => ShowAsync(siblings[position - 1])">‹</button>
                                <span>@(position + 1) of @siblings.Count</span>
                                <button disabled="@(Chat.IsBusy || position == siblings.Count - 1)" aria-label="Next version" @onclick="() => ShowAsync(siblings[position + 1])">›</button>
                            </span>
                        }
                        <button @onclick="() => Desktop.CopyText(m.Content)">Copy</button>
                        @if (!Chat.IsBusy)
                        {
                            <button @onclick="() => StartEdit(m)">Edit</button>
                            @if (!isUser)
                            {
                                <button disabled="@(!Engine.IsReady)" @onclick="() => RunAsync(() => Chat.RegenerateAsync(m.ConversationId, m.Id))">Regenerate</button>
                            }
                            else if (isLast)
                            {
                                <button disabled="@(!Engine.IsReady)" @onclick="() => RunAsync(() => Chat.ReplyToAsync(m.ConversationId, m.Id))">Answer</button>
                            }
                        }
                        @if (m.PromptText is not null)
                        {
                            <button @onclick="() => _inspect = m">Prompt</button>
                        }
                        @if (m.TokensPerSecond is > 0)
                        {
                            <span class="stat">@m.CompletionTokens tokens · @m.TokensPerSecond.Value.ToString("0.0") tok/s</span>
                        }
                    }
                </Actions>
            </MessageView>
        }
        @if (Streaming is { } reply)
        {
            <MessageView Name="@(Engine.ModelName ?? "Model")" Content="@reply.Content" Reasoning="@reply.Reasoning" Streaming="true" />
        }
        @if (Problem is { } problem)
        {
            <div class="notice bad"><span>@problem</span><button class="btn" @onclick="DismissProblem">Dismiss</button></div>
        }
    </div>
}

<SectionContent SectionName="composer">
    <div class="composer">
        <textarea @ref="_input" rows="1" aria-label="Message" @bind="_draft" @bind:event="oninput"
                  placeholder="@(Engine.IsReady ? "Message the model. Enter sends, Shift+Enter adds a line." : "Load a model to start chatting.")"></textarea>
        @if (Chat.IsBusy)
        {
            <button class="btn" @onclick="Chat.Stop">Stop</button>
        }
        else
        {
            <button class="btn primary" disabled="@(!Engine.IsReady || string.IsNullOrWhiteSpace(_draft))" @onclick="SendAsync">Send</button>
        }
    </div>
    @if (Usage is { } usage)
    {
        <div class="ctx" title="How much of the model's context window this chat is using">
            <div class="meter"><i style="width:@usage.Percent%"></i></div>
            <span>@usage.Used.ToString("N0") of @usage.Total.ToString("N0") tokens@(usage.Trimmed > 0 ? $" · {usage.Trimmed} older message{(usage.Trimmed == 1 ? "" : "s")} left out to fit" : "")</span>
        </div>
    }
</SectionContent>

<SectionContent SectionName="aside">
    <div class="panel">
        <h4>Style</h4>
        <select class="field" aria-label="Style" value="@_conversation.PresetId" @onchange="SetPresetAsync">
            @foreach (var preset in SamplerPresets.All)
            {
                <option value="@preset.Id">@preset.Name</option>
            }
        </select>
        <p class="small">@SamplerPresets.Get(_conversation.PresetId).Description</p>
    </div>
    <div class="panel">
        <h4>Instructions</h4>
        <textarea class="field" rows="6" aria-label="Instructions" placeholder="Optional. Tell the model how to behave in this chat."
                  value="@_conversation.SystemPrompt" @onchange="SetInstructionsAsync"></textarea>
    </div>
    @if (_conversation.Id != 0)
    {
        <div class="panel">
            <h4>This chat</h4>
            <input class="field" aria-label="Chat name" value="@_conversation.Title" @onchange="RenameAsync" />
            <div class="row">
                @if (_confirmDelete)
                {
                    <button class="btn danger" @onclick="DeleteAsync">Yes, delete it</button>
                    <button class="btn" @onclick="() => _confirmDelete = false">Keep</button>
                }
                else
                {
                    <button class="btn" @onclick="() => _confirmDelete = true">Delete chat</button>
                }
            </div>
        </div>
    }
</SectionContent>

@if (_inspect is { } inspected)
{
    <Modal Title="What the model was sent" Class="wide" OnClose="() => _inspect = null">
        <div class="about">
            <div class="kv"><span>Model</span><span>@inspected.ModelName</span></div>
            <div class="kv"><span>Style</span><span>@SamplerPresets.Get(inspected.PresetId).Name</span></div>
            <div class="kv"><span>Prompt size</span><span>@(inspected.PromptTokens?.ToString("N0") ?? "?") tokens</span></div>
            @if (inspected.CompletionTokens is { } written)
            {
                <div class="kv"><span>Reply size</span><span>@written.ToString("N0") tokens</span></div>
            }
            @if (inspected.TrimmedMessages is > 0)
            {
                <div class="kv"><span>Older messages left out to fit</span><span>@inspected.TrimmedMessages</span></div>
            }
        </div>
        <div class="code">
            <div class="code-head"><span>exact prompt text</span><button @onclick="() => Desktop.CopyText(inspected.PromptText!)">Copy</button></div>
            <pre class="wrap"><code>@inspected.PromptText</code></pre>
        </div>
    </Modal>
}

@code {
    [Parameter] public long? ChatId { get; set; }

    private List<Conversation> _chats = [];
    private Conversation _conversation = new();
    private MessageTree _tree = new([]);
    private IReadOnlyList<ChatMessage> _path = [];
    private int _loadVersion;

    private string _draft = "";
    private long? _editingId;
    private string _editText = "";
    private ChatMessage? _inspect;
    private bool _confirmDelete;
    private string? _notice;

    private ActiveReply? _seenActive;
    private bool _forceScroll;
    private ElementReference _input;
    private IJSObjectReference? _module;
    private DotNetObjectReference<General>? _self;

    /// <summary>The reply being written in this chat, if any.</summary>
    private ActiveReply? Streaming => Chat.Active is { } a && a.ConversationId == _conversation.Id && _conversation.Id != 0 ? a : null;

    /// <summary>The branch on screen. While a reply streams it ends at the question being answered.</summary>
    private IReadOnlyList<ChatMessage> Visible
    {
        get
        {
            if (Streaming is not { } reply) return _path;
            var end = IndexOf(_path, reply.ParentId);
            return end < 0 ? _path : _path.Take(end + 1).ToList();
        }
    }

    private string? Problem => _notice ?? (Chat.LastError is { } e && e.ConversationId == _conversation.Id ? e.Message : null);

    private (int Used, int Total, int Percent, int Trimmed)? Usage
    {
        get
        {
            if (!Engine.IsReady || Engine.ContextLength <= 0) return null;
            var last = _path.LastOrDefault(m => m.Role == ChatRole.Assistant && m.PromptTokens is not null);
            if (last is null) return null;
            var used = last.PromptTokens!.Value + (last.CompletionTokens ?? 0);
            return (used, Engine.ContextLength, Math.Clamp(used * 100 / Engine.ContextLength, 1, 100), last.TrimmedMessages ?? 0);
        }
    }

    protected override void OnInitialized()
    {
        Chat.Changed += OnChatChanged;
        Engine.Changed += OnEngineChanged;
        _seenActive = Chat.Active;
    }

    protected override async Task OnParametersSetAsync()
    {
        _editingId = null;
        _inspect = null;
        _confirmDelete = false;
        _notice = null;
        _forceScroll = true;
        await LoadAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try
        {
            _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./_content/DogAI.UI/js/chat.js");
            _self ??= DotNetObjectReference.Create(this);
            if (_input.Context is not null)
            {
                await _module.InvokeVoidAsync("initComposer", _input, _self);
                await _module.InvokeVoidAsync("resizeComposer", _input);
            }
            await _module.InvokeVoidAsync("followThread", _forceScroll);
            _forceScroll = false;
        }
        catch (Exception e) when (e is JSException or JSDisconnectedException or OperationCanceledException or ObjectDisposedException)
        {
            // Scrolling and Enter-to-send are conveniences; the screen works without them.
        }
    }

    private async Task LoadAsync()
    {
        var version = ++_loadVersion;
        var chats = (await Store.ListAsync("general")).ToList();
        Conversation? conversation = null;
        IReadOnlyList<ChatMessage> messages = [];
        if (ChatId is { } id)
        {
            conversation = await Store.GetAsync(id);
            if (conversation is not null) messages = await Store.GetMessagesAsync(id);
        }
        if (version != _loadVersion) return;

        _chats = chats;
        if (ChatId is not null && conversation is null)
        {
            Nav.NavigateTo("general", replace: true);
            return;
        }
        // On the "new chat" screen keep any style or instructions already chosen for it.
        _conversation = conversation ?? (_conversation.Id == 0 ? _conversation : new Conversation());
        _tree = new MessageTree(messages);
        _path = _tree.PathTo(_tree.ResolveLeaf(_conversation.ActiveLeafId));
    }

    private void OnEngineChanged() => InvokeAsync(StateHasChanged);

    private void OnChatChanged() => InvokeAsync(async () =>
    {
        var active = Chat.Active;
        if (active is null || !ReferenceEquals(active, _seenActive))
        {
            _seenActive = active;
            await LoadAsync();
        }
        StateHasChanged();
    });

    [JSInvokable]
    public Task SubmitFromKeyboard() => InvokeAsync(async () =>
    {
        await SendAsync();
        StateHasChanged();
    });

    private async Task SendAsync()
    {
        var text = _draft.Trim();
        if (text.Length == 0 || Chat.IsBusy || !Engine.IsReady) return;
        _draft = "";
        _notice = null;
        if (_conversation.Id == 0)
        {
            _conversation = await Store.CreateAsync(_conversation);
            ChatId = _conversation.Id;
            Nav.NavigateTo($"general/{_conversation.Id}");
        }
        var id = _conversation.Id;
        await RunAsync(() => Chat.SendAsync(id, text));
    }

    /// <summary>Runs a chat action and shows any refusal ("no model loaded") as a notice instead of crashing.</summary>
    private async Task RunAsync(Func<Task> action)
    {
        _forceScroll = true;
        try
        {
            await action();
        }
        catch (Exception e) when (e is InvalidOperationException or EngineException)
        {
            _notice = e.Message;
        }
    }

    private Task ShowAsync(ChatMessage message) => Chat.SelectBranchAsync(message.ConversationId, message.Id);

    private void StartEdit(ChatMessage message)
    {
        _editingId = message.Id;
        _editText = message.Content;
    }

    private async Task SaveEditAsync(ChatMessage message)
    {
        var text = _editText.Trim();
        _editingId = null;
        if (text.Length == 0 || text == message.Content) return;
        if (message.Role == ChatRole.User)
        {
            // A changed question starts a new branch and gets a fresh answer; the old one stays reachable.
            await RunAsync(() => Chat.EditAndResendAsync(message.ConversationId, message.Id, text));
        }
        else
        {
            message.Content = text;
            await Store.UpdateMessageAsync(message);
        }
    }

    private RenderFragment EditBox(ChatMessage message) => __builder =>
    {
        <div class="edit">
            <textarea class="field" rows="@Math.Clamp(_editText.Split('\n').Length + 1, 3, 16)" aria-label="Edit message" @bind="_editText"></textarea>
            <div class="row">
                <button class="btn primary" disabled="@(message.Role == ChatRole.User && !Engine.IsReady)" @onclick="() => SaveEditAsync(message)">
                    @(message.Role == ChatRole.User ? "Save and ask again" : "Save")
                </button>
                <button class="btn" @onclick="() => _editingId = null">Cancel</button>
            </div>
        </div>
    };

    private void DismissProblem()
    {
        _notice = null;
        if (Chat.LastError is not null) Chat.ClearError();
    }

    private async Task SetPresetAsync(ChangeEventArgs e)
    {
        _conversation.PresetId = SamplerPresets.Get(e.Value?.ToString()).Id;
        await SaveConversationAsync();
    }

    private async Task SetInstructionsAsync(ChangeEventArgs e)
    {
        _conversation.SystemPrompt = e.Value?.ToString() ?? "";
        await SaveConversationAsync();
    }

    private async Task RenameAsync(ChangeEventArgs e)
    {
        var title = (e.Value?.ToString() ?? "").Trim();
        if (title.Length == 0) return;
        _conversation.Title = title;
        await SaveConversationAsync();
        _chats = (await Store.ListAsync("general")).ToList();
    }

    private async Task SaveConversationAsync()
    {
        if (_conversation.Id != 0) await Store.UpdateAsync(_conversation);
    }

    private async Task DeleteAsync()
    {
        if (Streaming is not null) Chat.Stop();
        await Store.DeleteAsync(_conversation.Id);
        _conversation = new Conversation();
        Nav.NavigateTo("general");
    }

    private static int IndexOf(IReadOnlyList<ChatMessage> messages, ChatMessage message) => IndexOf(messages, message.Id);

    private static int IndexOf(IReadOnlyList<ChatMessage> messages, long id)
    {
        for (var i = 0; i < messages.Count; i++)
            if (messages[i].Id == id) return i;
        return -1;
    }

    private static string When(DateTime utc)
    {
        var local = DateTime.SpecifyKind(utc, DateTimeKind.Utc).ToLocalTime();
        return local.Date == DateTime.Today ? local.ToString("HH:mm") : local.ToString("d MMM");
    }

    public async ValueTask DisposeAsync()
    {
        Chat.Changed -= OnChatChanged;
        Engine.Changed -= OnEngineChanged;
        _self?.Dispose();
        try
        {
            if (_module is not null) await _module.DisposeAsync();
        }
        catch (Exception e) when (e is JSDisconnectedException or ObjectDisposedException)
        {
        }
    }
}

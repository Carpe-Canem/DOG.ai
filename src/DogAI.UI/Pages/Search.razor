@page "/search"
@implements IAsyncDisposable
@inject ISearchStore Finder
@inject ChatService Chat
@inject NavigationManager Nav
@inject IJSRuntime JS

<SectionContent SectionName="title">
    <div class="head-row">
        <div class="head-text">
            <h2>Search</h2>
            <p>Every chat, character chat and story on this PC</p>
        </div>
    </div>
</SectionContent>

<div class="search-page">
    <div class="search-box">
        <Icon Name="search" Size="18" />
        <input class="field" type="search" aria-label="Search your chats and stories" placeholder="Words to find, for example: dragon cave"
               autofocus @bind="_query" @bind:event="oninput" @bind:after="QueryChangedAsync" @onkeydown="OnKey" />
    </div>

    @if (_query.Trim().Length == 0)
    {
        <p class="small">Type a few words. Every word must appear; the last one can be unfinished. Matches in a chat's name come first.</p>
    }
    else if (_failed is not null)
    {
        <div class="notice bad"><span>@_failed</span></div>
    }
    else if (_hits is { Count: 0 } && !_busy)
    {
        <p class="small">Nothing found for "@_query.Trim()".</p>
    }
    else if (_hits is not null)
    {
        <div class="hits" role="list">
            @foreach (var h in _hits)
            {
                var hit = h;
                <button class="hit" role="listitem" @onclick="() => OpenAsync(hit)">
                    <span class="hit-top">
                        <span class="hit-title">@hit.Title</span>
                        <span class="chip">@ChatSearch.ModeLabel(hit.Mode)</span>
                        <span class="small">@Format.When(hit.UpdatedAt)</span>
                    </span>
                    <span class="hit-snippet">
                        @if (hit.MessageId is not null)
                        {
                            <span class="small hit-who">@(hit.Role == ChatRole.User ? "You: " : "Reply: ")</span>
                        }
                        @foreach (var part in ChatSearch.Parts(hit.Snippet))
                        {
                            if (part.Match)
                            {
                                <mark>@part.Text</mark>
                            }
                            else
                            {
                                @part.Text
                            }
                        }
                    </span>
                </button>
            }
        </div>
    }
</div>

@code {
    private string _query = "";
    private IReadOnlyList<ChatHit>? _hits;
    private string? _failed;
    private bool _busy;
    private int _version;
    private IJSObjectReference? _module;

    private async Task QueryChangedAsync()
    {
        var version = ++_version;
        // Wait for a pause in typing, then search.
        await Task.Delay(220);
        if (version != _version) return;
        await RunAsync(version);
    }

    private async Task OnKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await RunAsync(++_version);
    }

    private async Task RunAsync(int version)
    {
        _busy = true;
        try
        {
            var hits = await Finder.SearchAsync(_query);
            if (version != _version) return;
            _hits = hits;
            _failed = null;
        }
        catch (Exception e) when (e is System.Data.Common.DbException or InvalidOperationException)
        {
            if (version == _version) _failed = "The search did not work: " + e.Message;
        }
        finally
        {
            if (version == _version) _busy = false;
        }
    }

    /// <summary>Opens the chat on the branch that holds the match, so the message is on screen, and scrolls to it.</summary>
    private async Task OpenAsync(ChatHit hit)
    {
        if (hit.MessageId is { } messageId)
        {
            await Chat.SelectBranchAsync(hit.ConversationId, messageId);
            try
            {
                _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./_content/DogAI.UI/js/chat.js");
                await _module.InvokeVoidAsync("scrollToMessage", messageId);
            }
            catch (Exception e) when (e is JSException or JSDisconnectedException)
            {
                // Scrolling is a convenience; the chat still opens on the right branch.
            }
        }
        Nav.NavigateTo(hit.Route);
    }

    public async ValueTask DisposeAsync()
    {
        // The scroll helper keeps running after this page is gone; only the handle is let go.
        if (_module is not null)
        {
            try { await _module.DisposeAsync(); }
            catch (Exception e) when (e is JSDisconnectedException or ObjectDisposedException) { }
        }
    }
}

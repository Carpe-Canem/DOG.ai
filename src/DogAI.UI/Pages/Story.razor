@page "/story"
@page "/story/{StoryId:long}"
@using StoryInfo = DogAI.Core.Stories.Story
@implements IDisposable
@inject IChatStore Store
@inject IStoryStore Stories
@inject ChatService Chat
@inject EngineManager Engine
@inject IDesktopShell Desktop
@inject NavigationManager Nav

<SectionContent SectionName="title">
    <div class="head-row">
        <div class="head-text">
            <h2>@(_story is null ? "Story" : _conversation.Title)</h2>
            <p>@(_story is null ? "Authored stories and interactive adventures" : Interactive ? "Interactive adventure" : "Written story")</p>
        </div>
        <ModelPicker Mode="story" />
    </div>
</SectionContent>

<SectionContent SectionName="list"><StoryList ActiveId="@StoryId" Version="@_listVersion" /></SectionContent>

@if (!_loaded)
{
}
else if (_story is null)
{
    <div class="empty">
        <Icon Name="story" Size="40" />
        <h3>Tell a story</h3>
        <p>Write one with the model, passage by passage along an outline, or play one as an adventure where you choose what happens next.</p>
        <a class="btn primary" href="story/new">New story</a>
    </div>
}
else if (_path.Count == 0 && !Streaming)
{
    <div class="empty">
        <Icon Name="story" Size="40" />
        <h3>@_conversation.Title</h3>
        @if (_story.Bible.Premise.Trim().Length > 0)
        {
            <p>@_story.Bible.Premise</p>
        }
        @if (!Engine.IsReady)
        {
            <p>Load a model to start.</p>
            <ModelPicker Primary="true" Mode="story" />
        }
        else if (Interactive)
        {
            <button class="btn primary" disabled="@Chat.IsBusy" @onclick="BeginAsync">Begin the story</button>
        }
        else
        {
            <p>Press <b>Write next</b> below for the opening passage. You can say what should happen in it first.</p>
        }
        @if (_notice is not null)
        {
            <div class="notice bad"><span>@_notice</span><button class="btn" @onclick="() => _notice = null">Dismiss</button></div>
        }
    </div>
}
else
{
    <StoryThread Conversation="@_conversation" Info="@_story" Tree="@_tree" Path="@_path" @bind-Notice="_notice" />
}

@if (_story is not null)
{
    <SectionContent SectionName="composer">
        @if (Interactive)
        {
            @if (_path.Count > 0 || Streaming)
            {
                <ChatComposer Path="@_path" OnSend="ActAsync" SendLabel="Do it" Placeholder="Type what you do, or pick a choice above. Enter sends.">
                    <Extra>
                        @if (_story.Dice)
                        {
                            <label class="check small" title="Roll a 20-sided dice to decide how this action turns out"><input type="checkbox" @bind="_roll" /> Roll dice</label>
                        }
                    </Extra>
                </ChatComposer>
            }
        }
        else
        {
            @if (_story.Outline.Count > 0)
            {
                <div class="speak-row">
                    <label class="inline small">
                        Next passage goes in
                        <select class="field" aria-label="Chapter for the next passage" value="@TargetChapter" @onchange="e => _chapter = int.TryParse(e.Value?.ToString(), out var c) ? c : null">
                            @for (var i = 0; i < _story.Outline.Count; i++)
                            {
                                <option value="@i">@StoryPrompt.ChapterName(_story, i)</option>
                            }
                        </select>
                    </label>
                </div>
            }
            <ChatComposer Path="@_path" OnSend="WriteNextAsync" AllowEmpty="true" SendLabel="Write next"
                          Placeholder="Optional: say what should happen in the next passage. Enter writes it." />
        }
    </SectionContent>

    <SectionContent SectionName="aside">
        <div class="panel">
            <h4>Story</h4>
            @if (_story.Bible.Premise.Trim().Length > 0)
            {
                <p class="small premise">@_story.Bible.Premise</p>
            }
            <div class="row">
                <a class="btn" href="story/@_conversation.Id/setup" title="The premise, cast, world and style the model follows, and this story's settings">Story bible</a>
                @if (Interactive)
                {
                    <button class="btn" disabled="@(_tree.Count == 0)" @onclick="() => _map = true" title="Every path taken so far; go back to any point">Branch map</button>
                }
            </div>
        </div>
        @if (Interactive && _story.TrackState)
        {
            <StoryStatePanel State="@CurrentState" Disabled="@Chat.IsBusy" OnSave="SaveStateAsync" />
        }
        @if (!Interactive && _story.Outline.Count > 0)
        {
            <div class="panel">
                <h4>Outline</h4>
                <ol class="outline">
                    @for (var i = 0; i < _story.Outline.Count; i++)
                    {
                        var chapter = _story.Outline[i];
                        <li class="@(i == CurrentChapter && _path.Count > 0 ? "now" : "")" title="@chapter.Plan">@(chapter.Title.Trim().Length > 0 ? chapter.Title : $"Chapter {i + 1}")</li>
                    }
                </ol>
            </div>
        }
        <StylePanel Value="@_conversation.PresetId" ValueChanged="SetPresetAsync" />
        <MemoryPanel Conversation="@_conversation" Path="@_path" Streaming="@Streaming" Label="Summarise earlier passages when the story outgrows the model's context" />
        <div class="panel">
            <h4>Save a copy</h4>
            <p class="small">The branch on screen, as a file for reading elsewhere.</p>
            <div class="row">
                <button class="btn" disabled="@(_path.Count == 0)" @onclick="() => ExportAsync(ExportKind.Markdown)">Markdown</button>
                <button class="btn" disabled="@(_path.Count == 0)" @onclick="() => ExportAsync(ExportKind.Html)">Web page</button>
                <button class="btn" disabled="@(_path.Count == 0)" @onclick="() => ExportAsync(ExportKind.Epub)" title="An e-book for e-readers and reading apps">EPUB</button>
            </div>
            @if (_saved is not null)
            {
                <p class="small">Saved to @_saved</p>
            }
        </div>
        <div class="panel">
            <h4>This story</h4>
            <input class="field" aria-label="Story name" value="@_conversation.Title" @onchange="RenameAsync" />
            <div class="row">
                @if (_confirmDelete)
                {
                    <button class="btn danger" @onclick="DeleteAsync">Yes, delete it</button>
                    <button class="btn" @onclick="() => _confirmDelete = false">Keep</button>
                }
                else
                {
                    <button class="btn" @onclick="() => _confirmDelete = true">Delete story</button>
                }
            </div>
        </div>
    </SectionContent>

    @if (_map)
    {
        <BranchMapView Messages="@_messages" ActiveLeafId="@_conversation.ActiveLeafId" OnPick="GoToAsync" OnClose="() => _map = false" />
    }
}

@code {
    [Parameter] public long? StoryId { get; set; }

    private enum ExportKind { Markdown, Html, Epub }

    private Conversation _conversation = new();
    private StoryInfo? _story;
    private IReadOnlyList<ChatMessage> _messages = [];
    private MessageTree _tree = new([]);
    private IReadOnlyList<ChatMessage> _path = [];
    private bool _loaded;
    private int _loadVersion;
    private int _listVersion;
    private bool _confirmDelete;
    private bool _map;
    private bool _roll;
    private int? _chapter;
    private string? _notice;
    private string? _saved;
    private ActiveReply? _seenActive;

    private bool Interactive => _story?.Kind == StoryKind.Interactive;
    private bool Streaming => Chat.Active is { } a && a.ConversationId == _conversation.Id && _conversation.Id != 0;

    /// <summary>The chapter the newest passage belongs to.</summary>
    private int CurrentChapter => StoryTurn.LatestChapter(_path);

    /// <summary>Where the next passage goes: the chapter picked, else the one being written.</summary>
    private int TargetChapter => Math.Clamp(_chapter ?? CurrentChapter, 0, Math.Max(0, (_story?.Outline.Count ?? 1) - 1));

    private StoryState? CurrentState => _path.LastOrDefault(m => m.Role == ChatRole.Assistant) is { } last ? StoryTurn.Of(last).State ?? StoryTurn.LatestState(_path) ?? new StoryState() : null;

    protected override void OnInitialized()
    {
        Chat.Changed += OnChatChanged;
        Engine.Changed += OnEngineChanged;
        _seenActive = Chat.Active;
    }

    protected override async Task OnParametersSetAsync()
    {
        _confirmDelete = false;
        _notice = null;
        _saved = null;
        _map = false;
        _chapter = null;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        var version = ++_loadVersion;
        Conversation? conversation = null;
        StoryInfo? story = null;
        IReadOnlyList<ChatMessage> messages = [];
        if (StoryId is { } id)
        {
            conversation = await Store.GetAsync(id);
            story = conversation is null ? null : await Stories.GetAsync(id);
            if (story is not null) messages = await Store.GetMessagesAsync(id);
        }
        if (version != _loadVersion) return;

        if (StoryId is not null && story is null)
        {
            Nav.NavigateTo("story", replace: true);
            return;
        }
        _conversation = conversation ?? new Conversation();
        _story = story;
        _messages = messages;
        _tree = new MessageTree(messages);
        _path = _tree.PathTo(_tree.ResolveLeaf(_conversation.ActiveLeafId));
        _loaded = true;
    }

    private void OnEngineChanged() => InvokeAsync(StateHasChanged);

    private void OnChatChanged() => InvokeAsync(async () =>
    {
        var active = Chat.Active;
        if (active is null || !ReferenceEquals(active, _seenActive))
        {
            _seenActive = active;
            await LoadAsync();
        }
        StateHasChanged();
    });

    private async Task TryAsync(Func<Task> action)
    {
        if (Chat.IsBusy || !Engine.IsReady || _story is null) return;
        _notice = null;
        try
        {
            await action();
        }
        catch (Exception e) when (e is InvalidOperationException or EngineException)
        {
            _notice = e.Message;
        }
    }

    private Task BeginAsync() => TryAsync(() => Chat.BeginStoryAsync(_conversation.Id));

    private Task ActAsync(string text)
    {
        var roll = _roll;
        _roll = false;
        return TryAsync(() => Chat.ActAsync(_conversation.Id, text, roll));
    }

    private Task WriteNextAsync(string steering)
    {
        var chapter = TargetChapter;
        _chapter = null;
        return TryAsync(() => Chat.WriteNextAsync(_conversation.Id, steering, chapter));
    }

    private async Task GoToAsync(long passageId)
    {
        _map = false;
        _notice = null;
        try
        {
            await Chat.GoToAsync(_conversation.Id, passageId);
        }
        catch (InvalidOperationException e)
        {
            _notice = e.Message;
        }
    }

    private async Task SaveStateAsync(StoryState state)
    {
        if (_path.LastOrDefault(m => m.Role == ChatRole.Assistant) is { } last)
            await Chat.SetStoryStateAsync(_conversation.Id, last.Id, state);
    }

    private async Task SetPresetAsync(string id)
    {
        _conversation.PresetId = id;
        await Store.UpdateAsync(_conversation);
    }

    private async Task RenameAsync(ChangeEventArgs e)
    {
        var title = (e.Value?.ToString() ?? "").Trim();
        if (title.Length == 0) return;
        _conversation.Title = title;
        await Store.UpdateAsync(_conversation);
        _listVersion++;
    }

    private async Task DeleteAsync()
    {
        if (Streaming) Chat.Stop();
        await Store.DeleteAsync(_conversation.Id);
        _listVersion++;
        Nav.NavigateTo("story");
    }

    private async Task ExportAsync(ExportKind kind)
    {
        if (_story is null) return;
        _notice = null;
        _saved = null;
        var title = _conversation.Title;
        try
        {
            if (kind == ExportKind.Markdown)
                _saved = await Desktop.SaveFileAsync(title + ".md", "Markdown text (*.md)|*.md", System.Text.Encoding.UTF8.GetBytes(StoryExport.ToMarkdown(title, _story, _path)));
            else if (kind == ExportKind.Html)
                _saved = await Desktop.SaveFileAsync(title + ".html", "Web page (*.html)|*.html", System.Text.Encoding.UTF8.GetBytes(StoryExport.ToHtml(title, _story, _path)));
            else
                _saved = await Desktop.SaveFileAsync(title + ".epub", "EPUB e-book (*.epub)|*.epub", StoryExport.ToEpub(title, _story, _path));
        }
        catch (Exception e) when (e is IOException or UnauthorizedAccessException)
        {
            _notice = "Could not save the story: " + e.Message;
        }
    }

    public void Dispose()
    {
        Chat.Changed -= OnChatChanged;
        Engine.Changed -= OnEngineChanged;
    }
}

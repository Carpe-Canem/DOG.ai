@page "/settings"
@page "/settings/{Category}"
@implements IDisposable
@inject AppearanceState Appearance
@inject AppPaths Paths
@inject OnlineGate Gate
@inject NetworkAudit Audit
@inject ISettingsStore SettingsStore
@inject DogAI.Core.Stories.StoryOptions StoryOptions
@inject ChatOptions ChatThinking
@inject InterfaceMemory Memory
@inject NavigationManager Nav
@inject IJSRuntime JS

@* One category is shown at a time, but every category stays on the page (hidden), so the ids that walkthroughs and
   checks use keep working whichever category is open. The categories and the search entries are SettingsCatalog (Core). *@

<SectionContent SectionName="title">
    <h2>Settings</h2>
    <p>@Current.Title · changes apply immediately</p>
</SectionContent>

<SectionContent SectionName="list">
    <div class="list-head"><h3>Settings</h3></div>
    <input class="field list-search" id="settings-search" type="search" placeholder="Find a setting…" aria-label="Find a setting" autocomplete="off"
           @bind="_query" @bind:event="oninput" @onkeydown="SearchKeyAsync" />
    @if (!string.IsNullOrWhiteSpace(_query))
    {
        var hits = SettingsCatalog.Search(_query);
        @if (hits.Count == 0)
        {
            <p class="list-note" id="settings-no-hits">No setting matches “@_query.Trim()”.</p>
        }
        @foreach (var hit in hits)
        {
            var h = hit;
            <button type="button" class="li settings-hit" data-anchor="@h.Anchor" @onclick="() => OpenAsync(h)">
                <span class="li-text">
                    <span class="li-title">@h.Title</span>
                    <span class="li-sub">@SettingsCatalog.Find(h.Category).Title</span>
                </span>
            </button>
        }
    }
    else
    {
        @foreach (var c in SettingsCatalog.Categories)
        {
            <a class="li @(c.Id == Current.Id ? "active" : "")" href="@($"settings/{c.Id}")" data-category="@c.Id" aria-current="@(c.Id == Current.Id ? "page" : null)">
                <span class="li-text">
                    <span class="li-title">@c.Title</span>
                    <span class="li-sub">@c.About</span>
                </span>
            </a>
        }
    }
</SectionContent>

<PageTabs Class="narrow-only settings-tabs" Label="Settings categories" Current="@Current.Id"
          Items="@(SettingsCatalog.Categories.Select(c => (c.Id, c.Title)).ToList())" Href="@(id => $"settings/{id}")" />

<div class="settings" data-category="appearance" hidden="@Hidden(SettingsCatalog.Appearance)">
    <section>
        <h3 id="look-label">Look</h3>
        <div class="choice-grid" role="radiogroup" aria-labelledby="look-label">
            @foreach (var skin in Skins.All)
            {
                var active = skin.Id == Appearance.Skin;
                <label class="choice-card @(active ? "active" : "")">
                    <input type="radio" name="skin" value="@skin.Id" checked="@active" @onchange="() => Appearance.SetSkinAsync(skin.Id)" />
                    <svg viewBox="0 0 120 68" aria-hidden="true" fill="currentColor">@((MarkupString)Sketch[skin.Id])</svg>
                    <b>@skin.Name @if (skin.Id == Skins.Default) { <span class="chip">Default</span> }</b>
                    <span class="desc">@skin.Description</span>
                </label>
            }
        </div>
    </section>

    <section>
        <h3 id="theme-label">Light or dark</h3>
        <div class="seg" role="radiogroup" aria-labelledby="theme-label">
            @foreach (var (id, label) in ThemeChoices)
            {
                var active = id == Appearance.Theme;
                <label class="@(active ? "active" : "")">
                    <input type="radio" name="theme" value="@id" checked="@active" @onchange="() => Appearance.SetThemeAsync(id)" />@label
                </label>
            }
        </div>
    </section>
</div>

<div class="settings" data-category="chats" hidden="@Hidden(SettingsCatalog.Chats)">
    <section>
        <h3>Reading</h3>
        <div class="voice-settings">
            <div id="set-speech-colours">
                <label class="check">
                    <input type="checkbox" name="speech-colours" checked="@Appearance.SpeechColours" @onchange="e => Appearance.SetSpeechColoursAsync(e.Value is true)" />
                    Colour spoken lines and actions
                </label>
                <p class="small">In character chats, group chats and stories.<InfoButton About="speech colours">"Quoted speech" takes a colour and *actions* are toned down. In a group chat each member speaks in their own colour. General chats are never coloured.</InfoButton></p>
            </div>
        </div>
    </section>
    <section>
        <h3>Thinking</h3>
        <div class="voice-settings">
            <label id="set-general-thinking">
                @ChatOptions.GeneralSwitch
                <select class="field" id="general-thinking" @onchange="e => ChatThinking.SetGeneralAsync(LevelOf(e))">
                    @foreach (var level in ThinkingLevels.All)
                    {
                        <option value="@level" selected="@(level == ChatThinking.General)">@ThinkingLevels.Title(level)</option>
                    }
                </select>
                <span class="small" id="general-thinking-blurb">@ThinkingLevels.Blurb(ChatThinking.General)</span>
            </label>
            <label id="set-roleplay-thinking">
                @ChatOptions.RoleplaySwitch
                <select class="field" id="roleplay-thinking" @onchange="e => ChatThinking.SetRoleplayAsync(LevelOf(e))">
                    @foreach (var level in ThinkingLevels.All)
                    {
                        <option value="@level" selected="@(level == ChatThinking.Roleplay)">@ThinkingLevels.Title(level)</option>
                    }
                </select>
                <span class="small" id="roleplay-thinking-blurb">@ThinkingLevels.Blurb(ChatThinking.Roleplay)</span>
            </label>
            <label id="set-story-thinking">
                @ChatOptions.StorySwitch
                <select class="field" id="story-thinking" @onchange="e => StoryOptions.SetLevelAsync(LevelOf(e))">
                    @foreach (var level in ThinkingLevels.All)
                    {
                        <option value="@level" selected="@(level == StoryOptions.Level)">@ThinkingLevels.Title(level)</option>
                    }
                </select>
                <span class="small" id="story-thinking-blurb">@ThinkingLevels.Blurb(StoryOptions.Level)</span>
            </label>
            <p class="small">Each level is for its own kind of chat. While a reply thinks, Answer now (beside Stop) ends the thinking and makes the model answer.<InfoButton About="thinking">Some models think silently before they write. Off, they answer at once. With a limit, the thinking is cut when it reaches the limit and the model goes on to its answer; the reply says so in small type. With no limit they may plan as long as they like, which is slower, and a long think can fill the whole context and leave no answer at all; a reply like that says so. A story's choices, rewrites and the story plan draft never think for longer than their answer may be. Models that do not think, or cannot be told, are not affected. Memory summaries and DOG.ai's own jobs (the character draft, picture planning) never think.</InfoButton></p>
        </div>
    </section>
</div>

<div class="settings" data-category="voice" hidden="@Hidden(SettingsCatalog.Voice)">
    <section>
        <h3>Voice</h3>
        <VoiceSettings />
    </section>
</div>

<div class="settings" data-category="pictures" hidden="@Hidden(SettingsCatalog.Pictures)">
    <section>
        <h3>Pictures</h3>
        <PictureSettings />
    </section>
</div>

<div class="settings" data-category="privacy" hidden="@Hidden(SettingsCatalog.Privacy)">
    <section id="set-lock">
        <h3>Privacy</h3>
        <PrivacySettings />
    </section>
</div>

<div class="settings" data-category="windows" hidden="@Hidden(SettingsCatalog.Windows)">
    <section>
        <h3>Windows</h3>
        <WindowsSettings />
    </section>
</div>

<div class="settings" data-category="backup" hidden="@Hidden(SettingsCatalog.Backup)">
    <section id="set-backup">
        <h3>Backup and restore</h3>
        <BackupSettings />
    </section>
</div>

<div class="settings" data-category="about" hidden="@Hidden(SettingsCatalog.About)">
    <section id="set-about">
        <h3>About this install</h3>
        <div class="about">
            <div class="kv"><span>Version</span><span>@Version</span></div>
            @if (Paths.PortableHome is { } home)
            {
                <div class="kv"><span>Portable</span><span>Everything is kept in @home</span></div>
            }
            <div class="kv"><span>Data folder</span><span>@Paths.Root</span></div>
            <div class="kv"><span>Models folder</span><span>@(_settings?.ModelsDirectory ?? "Not set")</span></div>
            <div class="kv"><span>Network</span><span>@(Gate.IsOnline ? "Online" : "Offline")</span></div>
            <div class="kv"><span>Blocked connection attempts this session</span><span>@Audit.Snapshot().Count(e => !e.Allowed)</span></div>
        </div>
    </section>
</div>

@code {
    [Parameter] public string? Category { get; set; }

    private AppSettings? _settings;
    private string _query = "";
    private string? _scrollTo;
    private IJSObjectReference? _module;

    /// <summary>The category in the address; with none, the one shown last (Appearance the first time).</summary>
    private SettingsCategory Current => SettingsCatalog.Find(Category ?? Memory.SettingsCategory);

    private bool Hidden(string category) => Current.Id != category;

    /// <summary>The thinking level a list was set to.</summary>
    private static ThinkingLevel LevelOf(ChangeEventArgs e) =>
        Enum.TryParse<ThinkingLevel>(e.Value?.ToString(), out var level) && Enum.IsDefined(level) ? level : ThinkingLevel.Off;

    private static readonly (string Id, string Label)[] ThemeChoices =
        [(Themes.System, "Match Windows"), (Themes.Dark, "Dark"), (Themes.Light, "Light")];

    // Tiny layout diagrams for each skin; "hot" marks where the navigation lives.
    private static readonly Dictionary<string, string> Sketch = new()
    {
        [Skins.Workbench] = "<rect class='hot' x='6' y='6' width='8' height='56' rx='2'/><rect x='18' y='6' width='24' height='56' rx='2' opacity='.5'/><rect x='46' y='6' width='44' height='56' rx='2' opacity='.3'/><rect x='94' y='6' width='20' height='56' rx='2' opacity='.5'/>",
        [Skins.Fireside] = "<rect class='hot' x='38' y='6' width='44' height='6' rx='3'/><rect x='6' y='18' width='20' height='44' rx='2' opacity='.3'/><rect x='34' y='18' width='52' height='44' rx='2' opacity='.5'/><rect x='94' y='18' width='20' height='44' rx='2' opacity='.3'/>",
        [Skins.Playhouse] = "<rect class='hot' x='34' y='6' width='52' height='9' rx='4.5'/><rect x='6' y='21' width='24' height='41' rx='7' opacity='.5'/><rect x='34' y='21' width='52' height='41' rx='7' opacity='.4'/><rect x='90' y='21' width='24' height='41' rx='7' opacity='.5'/>",
    };

    private static string Version =>
        System.Reflection.Assembly.GetEntryAssembly()?.GetName().Version?.ToString(3) ?? "dev";

    protected override async Task OnInitializedAsync()
    {
        Appearance.Changed += Refresh;
        _settings = await SettingsStore.LoadAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        // A category opened by its address is the one shown next time Settings opens.
        if (Category is { } asked && SettingsCatalog.Category(asked) == asked) await Memory.SetSettingsCategoryAsync(asked);
    }

    private async Task OpenAsync(SettingsEntry entry)
    {
        _query = "";
        _scrollTo = entry.Anchor;
        if (entry.Category == Current.Id) StateHasChanged();
        else Nav.NavigateTo($"settings/{entry.Category}");
        await ScrollAsync();
    }

    private async Task SearchKeyAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") _query = "";
        else if (e.Key == "Enter" && SettingsCatalog.Search(_query) is [var first, ..]) await OpenAsync(first);
    }

    private async Task ScrollAsync()
    {
        if (_scrollTo is not { } id) return;
        _scrollTo = null;
        _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./_content/DogAI.UI/js/chat.js");
        await _module.InvokeVoidAsync("scrollToSetting", id);
    }

    private void Refresh() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Appearance.Changed -= Refresh;
        _ = _module?.DisposeAsync();
    }
}

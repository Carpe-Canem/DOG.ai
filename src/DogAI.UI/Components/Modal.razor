@* A centred dialog. The dimmed backdrop and Escape both close it. Opening it moves the focus into it (unless something
   inside already took it), so Escape works without a click inside first; closing puts the focus back where it was
   (chat.js modalOpened / modalClosed). *@
@implements IAsyncDisposable
@inject IJSRuntime JS

<div class="modal-back" @onclick="OnClose">
    <div class="modal @Class" role="dialog" aria-modal="true" aria-label="@Title" tabindex="-1" @ref="_box"
         @onclick:stopPropagation="true" @onclick="Nothing" @onkeydown="OnKey">
        <header class="modal-head">
            <h3>@Title</h3>
            <button class="btn" @onclick="OnClose">Close</button>
        </header>
        <div class="modal-body">@ChildContent</div>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter] public string Class { get; set; } = "";
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private ElementReference _box;
    private IJSObjectReference? _module;

    private static void Nothing() { }

    private Task OnKey(KeyboardEventArgs e) => e.Key == "Escape" ? OnClose.InvokeAsync() : Task.CompletedTask;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/DogAI.UI/js/chat.js");
            await _module.InvokeVoidAsync("modalOpened", _box);
        }
        catch (Exception e) when (e is JSException or JSDisconnectedException or OperationCanceledException)
        {
            // Without the script the dialog still works; Escape then needs the focus inside it first.
        }
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (_module is not null)
            {
                await _module.InvokeVoidAsync("modalClosed", _box);
                await _module.DisposeAsync();
            }
        }
        catch (Exception e) when (e is JSDisconnectedException or ObjectDisposedException or JSException)
        {
        }
    }
}

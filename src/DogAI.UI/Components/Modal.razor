@* A centred dialog. The dimmed backdrop and Escape both close it. *@
<div class="modal-back" @onclick="OnClose">
    <div class="modal @Class" role="dialog" aria-modal="true" aria-label="@Title" tabindex="-1"
         @onclick:stopPropagation="true" @onclick="Nothing" @onkeydown="OnKey">
        <header class="modal-head">
            <h3>@Title</h3>
            <button class="btn" @onclick="OnClose">Close</button>
        </header>
        <div class="modal-body">@ChildContent</div>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter] public string Class { get; set; } = "";
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private static void Nothing() { }

    private Task OnKey(KeyboardEventArgs e) => e.Key == "Escape" ? OnClose.InvokeAsync() : Task.CompletedTask;
}

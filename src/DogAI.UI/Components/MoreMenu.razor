@* A "⋯" button that opens a small menu of the less used actions. A click on an item, outside the menu, or Escape
   closes it. Items are buttons with class "menu-item" ("menu-item danger" for Delete); a "menu-note" is plain text.
   The menu opens below its button, or above it when there is no room below (the last card of a list). *@
@inject IJSRuntime JS

<div class="more-menu @(_open ? "open" : "")" @onkeydown="OnKey">
    <button type="button" class="btn more-btn" id="@Id" aria-label="@Label" title="@Label" aria-haspopup="menu" aria-expanded="@(_open ? "true" : "false")" @onclick="Toggle">
        <Icon Name="more" Size="18" />
    </button>
    @if (_open)
    {
        <div class="menu-back" @onclick="Close"></div>
        <div class="menu-pop" @ref="_pop" role="menu" aria-label="@Label" @onclick="Close">@ChildContent</div>
    }
</div>

@code {
    [Parameter] public string Label { get; set; } = "More";
    [Parameter] public string? Id { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private bool _open;
    private bool _place;
    private ElementReference _pop;

    private void Toggle() => _place = _open = !_open;
    private void Close() => _open = false;

    private void OnKey(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") _open = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_place || !_open) return;
        _place = false;
        try
        {
            await using var module = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/DogAI.UI/js/chat.js");
            await module.InvokeVoidAsync("placeMenu", _pop);
        }
        catch (Exception e) when (e is JSException or JSDisconnectedException or OperationCanceledException)
        {
            // Without it the menu opens downwards, as it always did.
        }
    }
}

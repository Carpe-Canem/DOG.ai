@* The Looks box of a character or persona: the appearance words that go into every picture of them, and optionally a
   character LoRA. The chat model can draft the words from the description, or (M19 step 2) look at the portrait in the
   editor and draft them from what it sees: the page makes the portrait into the 1,024-pixel JPEG every picture for the
   model is (attach.js), Core makes it plain and checks it, and it is held only for that one request. Works on a copy
   (Value); the page saves it. *@
@using DogAI.Core.Images
@using DogAI.Engine.Images
@implements IAsyncDisposable
@inject PictureWriter Writer
@inject EngineManager Engine
@inject ChatService Chat
@inject ModelLauncher Launcher
@inject ImageModelCatalog Catalog
@inject ISettingsStore SettingsStore
@inject DogAI.Engine.Images.ExtraTags ExtraTagList
@inject IJSRuntime JS

<div class="field-block looks-box">
    <div class="field-label">
        Looks
        <span class="small">How @Who look@(Who == "you" ? "" : "s") in pictures: these words go into every picture of @Them. Never sent to the chat model.</span>
    </div>
    <textarea class="field" id="looks-tags" rows="2" maxlength="@Looks.MaxTagsLength" value="@Value.Tags" disabled="@(_draftCts is not null)"
              placeholder="@(_style == PromptStyle.Tags ? "1girl, silver hair, long hair, green eyes, scar on cheek" : "a tall woman with long silver hair, green eyes and a scar on her cheek")"
              @onchange="e => Set(Value with { Tags = e.Value?.ToString() ?? string.Empty })"></textarea>
    <div class="row">
        @if (_draftCts is not null)
        {
            <button class="btn" id="looks-draft-stop" @onclick="() => _draftCts?.Cancel()">Stop</button>
            <span class="small" id="looks-working" role="status">@_working</span>
        }
        else
        {
            <button class="btn" id="looks-draft" disabled="@(Chat.IsBusy || string.IsNullOrWhiteSpace(About))"
                    title="The loaded chat model reads the description and writes the looks for you to change" @onclick="() => DraftAsync(fromPortrait: false)">Draft from the description</button>
            <button class="btn" id="looks-from-portrait" disabled="@(Chat.IsBusy || Portrait is null || CannotSee() is not null)"
                    title="@PortraitLooks.Title" @onclick="() => DraftAsync(fromPortrait: true)">@PortraitLooks.Button</button>
            @if (Chat.IsBusy)
            {
                <span class="small">Waiting for a chat reply to finish.</span>
            }
            else if (Portrait is null)
            {
                <span class="small" id="looks-portrait-none">@(string.IsNullOrWhiteSpace(About) ? PortraitLooks.NeitherYet(Persona) : PortraitLooks.NoPortrait(Persona))</span>
            }
            else if (string.IsNullOrWhiteSpace(About))
            {
                <span class="small">Write a description to draft from it too.</span>
            }
        }
    </div>
    @if (Portrait is not null && _draftCts is null && CannotSee() is { } blind)
    {
        <div class="notice" id="looks-sees"><span>@blind.Text <a class="link-text" href="@blind.Address">@blind.PlaceName</a>.</span></div>
    }
    @if (_note is not null)
    {
        <p class="small" id="looks-note">@_note</p>
    }
    @if (_error is not null)
    {
        <div class="notice bad" id="looks-error"><span>@_error</span></div>
    }
    @if (_loras.Count > 0 || Value.Lora is not null)
    {
        <div class="two">
            <label>
                @(Persona ? "Your LoRA" : "Character LoRA")
                <select class="field" id="looks-lora" @onchange="e => Set(Value with { Lora = e.Value?.ToString() is { Length: > 0 } l ? l : null })">
                    <option value="" selected="@(Value.Lora is null)">None</option>
                    @foreach (var lora in _loras)
                    {
                        <option value="@lora" selected="@(lora == Value.Lora)">@Path.GetFileNameWithoutExtension(lora)</option>
                    }
                    @if (Value.Lora is { } missing && !_loras.Contains(missing))
                    {
                        <option value="@missing" selected>@Path.GetFileNameWithoutExtension(missing) (not in the loras folder)</option>
                    }
                </select>
                <span class="small">A LoRA trained on @(Persona ? "how you look" : "this character"), if you have one. Its trigger words are added for you.</span>
            </label>
            <label>
                LoRA strength
                <input class="field" id="looks-strength" type="number" step="0.05" min="@Looks.MinStrength" max="@Looks.MaxStrength" disabled="@(Value.Lora is null)"
                       placeholder="The LoRA’s own" value="@(Value.LoraStrength?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "")"
                       @onchange="StrengthChanged" />
                <span class="small">Leave empty to use the strength set for the LoRA in @ModelsPlaces.LorasName.</span>
            </label>
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public Looks Value { get; set; } = Looks.None;
    [Parameter] public EventCallback<Looks> ValueChanged { get; set; }

    /// <summary>What the looks are drafted from: the description as it is in the form now.</summary>
    [Parameter] public string About { get; set; } = "";

    /// <summary>
    /// The picture "Draft from the portrait" looks at, as it is in the editor now (saved or not): a character's full
    /// picture, else its small square; a persona's square. Null when there is none.
    /// </summary>
    [Parameter] public byte[]? Portrait { get; set; }

    [Parameter] public string Name { get; set; } = "";

    /// <summary>True on the personas page, where the looks are the owner's own.</summary>
    [Parameter] public bool Persona { get; set; }

    private string Who => Persona ? "you" : "the character";
    private string Them => Persona ? "you" : "them";

    private PromptStyle _style = PromptStyle.Tags;
    private IReadOnlyList<string> _loras = [];
    private CancellationTokenSource? _draftCts;
    private string? _note, _error, _working;
    private IJSObjectReference? _module;

    /// <summary>The Characters default's name when it cannot see (no picture input beside it; read once on open), else null.</summary>
    private string? _blindDefault;

    /// <summary>
    /// The model that would look cannot see: the one in memory (the engine's own word), else the Characters default (by
    /// its file). Null when it can, or when that is not known yet (a model loading).
    /// </summary>
    private PlaceLine? CannotSee() =>
        Engine.IsReady ? (Engine.SeesPictures ? null : PortraitLooks.CannotSee(null))
        : Engine.State == EngineState.Loading ? null
        : _blindDefault is { } name ? PortraitLooks.CannotSee(name)
        : null;

    protected override async Task OnInitializedAsync()
    {
        Engine.Changed += Refresh;
        Chat.Changed += Refresh;
        // Which LoRAs there are, and whether the checkpoint pictures are drawn with wants tags or sentences. Reads file
        // headers only (remembered between visits); starts nothing.
        var settings = await SettingsStore.LoadAsync();
        var root = settings.ImageFolder();
        // The tag check follows the image folder in use now (it may have been changed since DOG.ai started).
        await ExtraTagList.FollowAsync(root);
        var files = await Task.Run(() => ImageLibrary.Scan(root));
        _loras = files.Where(f => f.Usable && f.Kind == ImageFileKind.Lora).Select(f => ImageModelCatalog.Normalise(f.RelativePath)).ToList();
        var checkpoints = files.Where(f => f.Usable && f.Kind == ImageFileKind.Checkpoint).ToList();
        if (Catalog.ChosenAmong(checkpoints.Select(c => c.RelativePath).ToList()) is { } chosen)
            _style = Catalog.CheckpointFor(chosen, checkpoints.First(c => c.RelativePath == chosen).Verdict).Style;
        if (ModelDefaults.For(settings, "characters") is { } model && File.Exists(model))
            _blindDefault = await Task.Run(() => ModelProjector.Find(model) is null ? Path.GetFileNameWithoutExtension(model) : null);
    }

    private void Refresh() => _ = InvokeAsync(StateHasChanged);

    private Task Set(Looks next)
    {
        Value = next;
        return ValueChanged.InvokeAsync(next);
    }

    private Task StrengthChanged(ChangeEventArgs e) =>
        Set(Value with
        {
            LoraStrength = double.TryParse(e.Value?.ToString(), System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out var s)
                ? Math.Clamp(s, Looks.MinStrength, Looks.MaxStrength)
                : null,
        });

    /// <summary>
    /// Asks the chat model for the looks, from the description or from the portrait, and puts them in the box, unsaved.
    /// A LoRA already chosen is kept.
    /// </summary>
    private async Task DraftAsync(bool fromPortrait)
    {
        _error = _note = null;
        using var cts = new CancellationTokenSource();
        _draftCts = cts;
        try
        {
            // The portrait as the JPEG the model is given, made by the page and made plain here. Held only for this request.
            byte[]? jpeg = null;
            if (fromPortrait)
            {
                if (Portrait is not { } portrait) return;
                _working = "Reading the picture…";
                StateHasChanged();
                _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./_content/DogAI.UI/js/attach.js");
                var made = await _module.InvokeAsync<byte[]?>("bytesToJpeg", cts.Token,
                    [portrait, AttachedPictures.MaxSide, AttachedPictures.Quality, ComposerPictures.MaxFileBytes]);
                if (made is not { Length: > 0 })
                {
                    _error = "The picture could not be read. Choose it again, then try again.";
                    return;
                }
                jpeg = AttachedPictures.Plain(made);
            }
            if (!Engine.IsReady)
            {
                _working = "Loading the model…";
                StateHasChanged();
                bool ready;
                try
                {
                    // Waits for a model the page is already loading, else loads the Characters default.
                    ready = await Launcher.EnsureReadyAsync(await SettingsStore.LoadAsync(), "characters", cts.Token);
                }
                catch (ModelRefusedException e)
                {
                    _error = e.Message;
                    return;
                }
                if (!ready)
                {
                    _error = "No model is loaded. Load one with the model button in Characters, then try again.";
                    return;
                }
            }
            cts.Token.ThrowIfCancellationRequested();
            LooksDraft draft;
            if (jpeg is not null)
            {
                // The engine's own word, once the model is in: picture input that failed to load leaves it blind.
                if (!Engine.SeesPictures)
                {
                    var blind = PortraitLooks.CannotSee(null);
                    _error = blind.Text + " " + blind.PlaceName + ".";
                    return;
                }
                _working = PortraitLooks.Looking(Engine.IsLoaded);
                StateHasChanged();
                draft = await Writer.DraftLooksFromPictureAsync(jpeg, Name, _style, TagList.Current, cts.Token);
            }
            else
            {
                _working = "Reading the description…";
                StateHasChanged();
                draft = await Writer.DraftLooksAsync(Name, About, _style, ct: cts.Token);
            }
            // Stopped, or the box was left (another character or persona opened): the draft is not theirs.
            cts.Token.ThrowIfCancellationRequested();
            await Set(Value with { Tags = draft.Tags });
            _note = (jpeg is not null ? PortraitLooks.Drafted : "Drafted. Change what you like; it is saved with the rest.") +
                    (draft.Notes.Corrected.Count > 0 ? " Corrected to real tags: " + string.Join("; ", draft.Notes.Corrected.Select(c => $"{c.Written} → {c.Used}")) + "." : "") +
                    (draft.Notes.Dropped.Count > 0 ? " Left out because they are not tags these checkpoints know: " + string.Join(", ", draft.Notes.Dropped) + ". Add them by hand if you know they work." : "");
        }
        catch (OperationCanceledException)
        {
        }
        catch (JSException)
        {
            _error = "The picture could not be read. Choose it again, then try again.";
        }
        catch (Exception e) when (e is InvalidOperationException or EngineException)
        {
            _error = e.Message;
        }
        finally
        {
            _draftCts = null;
            _working = null;
        }
    }

    public async ValueTask DisposeAsync()
    {
        _draftCts?.Cancel();
        Engine.Changed -= Refresh;
        Chat.Changed -= Refresh;
        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (Exception e) when (e is JSDisconnectedException or ObjectDisposedException)
            {
            }
        }
    }
}

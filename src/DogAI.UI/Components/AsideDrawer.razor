@* The side panel as a drawer below 1050 px (SidePanelDrawer): the dimmed backdrop behind it, and closing it on a click
   outside, Escape, another page, or the window growing past 1050 px (chat.js watchDrawer). Opening it moves the focus
   to its close button; closing puts the focus back where it was. Sits in MainLayout inside .shell. *@
@implements IAsyncDisposable
@inject SidePanelDrawer Drawer
@inject NavigationManager Nav
@inject IJSRuntime JS

@if (Drawer.Open)
{
    <div class="drawer-back" @onclick="Drawer.Close"></div>
}

@code {
    private IJSObjectReference? _module;
    private DotNetObjectReference<AsideDrawer>? _self;
    private bool _wasOpen;

    protected override void OnInitialized()
    {
        Drawer.Changed += Refresh;
        Nav.LocationChanged += OnLocationChanged;
    }

    private void Refresh() => _ = InvokeAsync(StateHasChanged);
    private void OnLocationChanged(object? sender, LocationChangedEventArgs e) => Drawer.Close();

    [JSInvokable]
    public void Close() => Drawer.Close();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Drawer.Open == _wasOpen) return;
        _wasOpen = Drawer.Open;
        try
        {
            _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./_content/DogAI.UI/js/chat.js");
            _self ??= DotNetObjectReference.Create(this);
            if (_wasOpen) await _module.InvokeVoidAsync("drawerOpened", _self);
            else await _module.InvokeVoidAsync("drawerClosed");
        }
        catch (Exception e) when (e is JSException or JSDisconnectedException or OperationCanceledException)
        {
            // Without the script the drawer still opens and closes with its buttons and the backdrop.
        }
    }

    public async ValueTask DisposeAsync()
    {
        Drawer.Changed -= Refresh;
        Nav.LocationChanged -= OnLocationChanged;
        try
        {
            if (_module is not null)
            {
                await _module.InvokeVoidAsync("drawerClosed");
                await _module.DisposeAsync();
            }
        }
        catch (Exception e) when (e is JSDisconnectedException or ObjectDisposedException or JSException)
        {
        }
        _self?.Dispose();
    }
}

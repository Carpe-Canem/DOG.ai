@implements IDisposable
@inject ModelsContext Ctx
@inject OnlineGate Gate

<div class="seg" role="radiogroup" aria-label="Use">
    @foreach (var (id, label) in Filters)
    {
        var active = id == _filter;
        <label class="@(active ? "active" : "")">
            <input type="radio" name="usecase" value="@id" checked="@active" @onchange="() => _filter = id" />@label
        </label>
    }
</div>

@* Every pick is listed with its fit badge; the short curated list has no "too large" switch. *@
<div class="filter-bar">
    <label class="check"><input type="checkbox" checked="@Uncensored" @onchange="e => Ctx.SetFilterAsync(e.Value is true ? ModelFilters.Uncensored : ModelFilters.Usable)" /> Uncensored versions</label>
    @if (Uncensored)
    {
        <span class="small">Community edits with refusals removed. They may be a little less accurate than the originals.</span>
    }
</div>

@foreach (var useCase in CuratedPicks.UseCases.Where(u => _filter == "all" || u == _filter))
{
    var picks = Rows.Where(r => r.Pick.UseCase == useCase).ToList();
    if (picks.Count == 0) continue;
    var bestIndex = picks.FindIndex(r => r.Fit?.Kind == FitKind.Full);
    <section class="group">
        <h3 class="group-title">@CuratedPicks.Label(useCase)</h3>
        <div class="models">
            @for (var i = 0; i < picks.Count; i++)
            {
                var row = picks[i];
                <div class="model has-fit">
                    <div class="li-text">
                        <div class="model-name">@row.Pick.Title@if (i == bestIndex) {<span class="rec">Best pick</span>}</div>
                        <div class="model-meta">@row.Pick.Blurb</div>
                        <div class="model-meta">@Meta(row)</div>
                        @if (row.Variant is { } shown && Blind(row.Pick, shown))
                        {
                            <div class="model-meta installed-blind">@Projectors.InstalledBlind <a href="@ModelsPlaces.Address(ModelsPlaces.Library)">@ModelsPlaces.LibraryName</a> › ⋯ › Get picture input.</div>
                        }
                        @if (useCase != "embedding")
                        {
                            <BesidePicturesChip Fit="row.Fit" Sees="@(row.Projector is not null)" />
                        }
                    </div>
                    <FitBadge Fit="row.Fit" />
                    <DownloadButton Repo="@row.Pick.Repo" Variant="@(row.Real ? row.Variant : null)" UseCase="@useCase" Primary="@(i == bestIndex)"
                                    Installed="@(row.Variant is { } v && Installed.Contains(v.Main.Path.Split('/')[^1]))"
                                    Fit="row.Fit" Projector="row.Projector" />
                </div>
            }
        </div>
    </section>
}

<p class="note">
    Picks were researched on @CuratedPicks.Updated. Sizes marked ≈ are estimates until DOG.ai is online.
    @if (_error is not null) { <span> Could not fetch file lists: @_error</span> }
</p>

@code {
    /// <summary>File names of models already on disk.</summary>
    [Parameter] public IReadOnlySet<string> Installed { get; set; } = new HashSet<string>();

    /// <summary>File names of installed models without a projector: offered with none, judged without one, and said so.</summary>
    [Parameter] public IReadOnlySet<string> InstalledBlind { get; set; } = new HashSet<string>();

    private static readonly (string, string)[] Filters =
        [("all", "All"), ("general", "General"), ("characters", "Characters"), ("story", "Story"), ("embedding", "Document search")];

    private string _filter = "all";
    private string? _error;

    /// <param name="Projector">The projector downloaded with it so it can see pictures, when its repository has one (known once online).</param>
    private sealed record Row(CuratedPick Pick, ModelVariant? Variant, FitResult? Fit, bool Real, RemoteFile? Projector);

    /// <summary>Shares the Browse tab's choice, so asking for uncensored models carries over between tabs.</summary>
    private bool Uncensored => Ctx.Filter == ModelFilters.Uncensored;

    private IEnumerable<Row> Rows => CuratedPicks.Shown(Uncensored).Select(pick =>
    {
        var variants = _real.GetValueOrDefault(pick.Repo);
        var real = variants is not null;
        variants ??= pick.EstimatedVariants();
        // Judged with the projector that comes with each version (picture input), as it will be loaded.
        ModelShape Shape(ModelVariant v) => pick.EstimatedShape(v.Size, Projector(pick, v)?.Size ?? 0);
        // No version can run here: the smallest is listed, marked too large, and can still be downloaded.
        var best = Ctx.Best(variants, Shape) ?? variants.MinBy(v => v.Size);
        var fit = best is null ? null : Ctx.Fit(Shape(best));
        return new Row(pick, best, fit, real, best is null ? null : Projector(pick, best));
    });

    private readonly Dictionary<string, IReadOnlyList<ModelVariant>> _real = new(StringComparer.OrdinalIgnoreCase);

    /// <summary>A document search model is given no pictures, so it is offered without a projector.</summary>
    private RemoteFile? Projector(CuratedPick pick, ModelVariant variant) =>
        pick.UseCase == "embedding" || !_real.ContainsKey(pick.Repo) || Blind(pick, variant) ? null : Ctx.ProjectorFor(pick.Repo, variant);

    /// <summary>This version is on this PC without its projector, while its repository has one: it cannot see as it is.</summary>
    private bool Blind(CuratedPick pick, ModelVariant variant) =>
        pick.UseCase != "embedding" && _real.ContainsKey(pick.Repo) && InstalledBlind.Contains(variant.Main.Path.Split('/')[^1])
        && Ctx.ProjectorFor(pick.Repo, variant) is not null;

    private static string Meta(Row row)
    {
        if (row.Variant is null) return "No files were found for this model.";
        var size = row.Real ? Sizes.Gb(row.Variant.Size) : "≈" + Sizes.Gb(row.Variant.Size);
        return $"{row.Variant.Quant} · {size}" + (row.Projector is { } p ? $" {Projectors.WithInput(p.Size)}" : "")
            + (row.Fit?.Kind == FitKind.TooLarge ? " · the smallest version; none can run on this PC" : "");
    }

    protected override async Task OnInitializedAsync()
    {
        Ctx.Changed += Refresh;
        Gate.Changed += OnGate;
        await FetchAsync();
    }

    private void Refresh() => InvokeAsync(StateHasChanged);
    private void OnGate() => InvokeAsync(FetchAsync);

    private async Task FetchAsync()
    {
        if (!Gate.IsOnline) return;
        _error = null;
        var repos = CuratedPicks.All.Select(p => p.Repo).Distinct(StringComparer.OrdinalIgnoreCase).Where(r => !_real.ContainsKey(r));
        await Task.WhenAll(repos.Select(async repo =>
        {
            try
            {
                _real[repo] = await Ctx.VariantsAsync(repo);
            }
            catch (Exception e) when (e is HubException or HttpRequestException or OfflineException or HostNotAllowedException)
            {
                _error = e.Message;
            }
        }));
        StateHasChanged();
    }

    public void Dispose()
    {
        Ctx.Changed -= Refresh;
        Gate.Changed -= OnGate;
    }
}

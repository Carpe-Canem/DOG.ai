@* Models › On this PC › Voice: the speech recognition models and voices in the "voice" folder inside the models
   folder: which speech model is used, and deleting. Downloading them is Get models › Voice (VoiceDownloads). *@
@implements IDisposable
@inject DownloadManager Downloads
@inject ISettingsStore SettingsStore
@inject ISpeechSynthesizer Voices

@foreach (var (listening, heading, none) in Sections)
{
    var found = _found.Where(f => f.Listening == listening && !Downloading(f.Target)).ToList();
    <section class="group">
        <h3 class="group-title">@heading</h3>
        @if (_scanned && found.Count == 0)
        {
            <p class="note" data-none="@(listening ? "listening" : "voices")">@none Get one in <a href="@ModelsPlaces.Address(ModelsPlaces.GetVoice)">Get models › Voice</a>.</p>
        }
        <div class="models">
            @foreach (var item in found)
            {
                var o = item;
                var inUse = o.Listening && o.Target.Equals(_speechModel, StringComparison.OrdinalIgnoreCase);
                <div class="model has-fit" data-voice="@o.Target">
                    <div class="li-text">
                        <div class="model-name">@VoiceCatalog.Title(o.Target)@if (inUse) {<span class="rec">In use</span>}</div>
                        @if (VoiceCatalog.All.FirstOrDefault(d => d.Target.Equals(o.Target, StringComparison.OrdinalIgnoreCase)) is { } known)
                        {
                            <div class="model-meta">@known.Blurb</div>
                        }
                        <div class="model-meta">@(o.Listening ? "Speech recognition" : "Voice") · @Sizes.Gb(o.Size)</div>
                    </div>
                    <div class="actions">
                        @if (o.Listening && !inUse)
                        {
                            <button class="btn" @onclick="() => UseSpeechModelAsync(o.Target)">Use this</button>
                        }
                        <button class="btn danger" @onclick="() => _confirmDelete = (VoiceCatalog.Title(o.Target), o.Target, o.Size)">Delete</button>
                    </div>
                </div>
            }
        </div>
    </section>
}

@if (_error is not null)
{
    <div class="notice bad"><span>@_error</span></div>
}
<p class="note">
    Voice models are in <b>@(_folder ?? "the models folder")</b>; Windows’ own voices work without one.
    Default voice, microphone and speakers: <a href="settings/voice">Settings › Voice</a>.<InfoButton About="voices">A character’s own voice is chosen in its editor (Looks and voice), and a story’s narrator in the story’s setup (World and style).</InfoButton>
</p>

@if (_confirmDelete is { } doomed)
{
    <Modal Title="Delete this voice model?" OnClose="() => _confirmDelete = null">
        <p>This permanently deletes <b>@doomed.Title</b> (@Sizes.Gb(doomed.Size)) from <b>@_folder</b>. It does not go to the Recycle Bin. You can download it again later.</p>
        <div class="row end">
            <button class="btn" @onclick="() => _confirmDelete = null">Keep it</button>
            <button class="btn danger" @onclick="DeleteAsync">Delete</button>
        </div>
    </Modal>
}

@code {
    private static readonly (bool Listening, string Heading, string None)[] Sections =
    [
        (true, "Listening", "No speech recognition model yet, so the microphone cannot be used."),
        (false, "Voices", "No downloaded voices yet; replies are read with Windows’ own voices."),
    ];

    private sealed record Found(string Target, long Size, bool Listening);

    private string? _folder;
    private string? _speechModel;
    private bool _scanned;
    private IReadOnlyList<Found> _found = [];
    private string? _error;
    private (string Title, string Target, long Size)? _confirmDelete;

    protected override async Task OnInitializedAsync()
    {
        Downloads.Completed += OnCompleted;
        await ScanAsync();
    }

    private void OnCompleted(DownloadJob job) => InvokeAsync(ScanAsync);

    /// <summary>Still arriving: a voice whose download has not finished is not on this PC yet.</summary>
    private bool Downloading(string target) => Downloads.Jobs.Any(j => j.UseCase == VoiceUse && j.Status != DownloadStatus.Done &&
        (j.Parts[0].FileName.Equals(target, StringComparison.OrdinalIgnoreCase) ||
         Path.GetFileName(j.Folder.TrimEnd('\\')).Equals(target, StringComparison.OrdinalIgnoreCase)));

    private async Task ScanAsync()
    {
        var settings = await SettingsStore.LoadAsync();
        _folder = settings.VoiceFolder();
        var folder = _folder;
        _found = await Task.Run(() =>
            VoiceLibrary.SpeechModels(folder).Select(m => new Found(m.Name, m.SizeBytes, true))
                .Concat(VoiceLibrary.Packs(folder).Select(p => new Found(p.Name, p.SizeBytes, false)))
                .ToList());
        // The speech model used: the chosen one, else the first found (as the recognizer picks).
        var speech = VoiceLibrary.SpeechModels(folder);
        _speechModel = speech.FirstOrDefault(m => m.Name.Equals(settings.SpeechModel, StringComparison.OrdinalIgnoreCase))?.Name ?? speech.FirstOrDefault()?.Name;
        _scanned = true;
        StateHasChanged();
    }

    private async Task UseSpeechModelAsync(string file)
    {
        await SettingsStore.SaveAsync(await SettingsStore.LoadAsync() with { SpeechModel = file });
        await ScanAsync();
    }

    /// <summary>The use case voice downloads carry, so the app knows not to list them among chat models.</summary>
    public const string VoiceUse = "voice";

    private async Task DeleteAsync()
    {
        if (_confirmDelete is not { } doomed || _folder is null) return;
        _confirmDelete = null;
        _error = null;
        var path = Path.Combine(_folder, doomed.Target);
        try
        {
            await Task.Run(() =>
            {
                if (File.Exists(path)) File.Delete(path);
                else if (Directory.Exists(path)) Directory.Delete(path, recursive: true);
            });
        }
        catch (Exception e) when (e is IOException or UnauthorizedAccessException)
        {
            _error = $"Could not delete it: {e.Message} If it is speaking or listening right now, try again in a moment.";
        }
        Voices.Refresh();
        await ScanAsync();
    }

    public void Dispose() => Downloads.Completed -= OnCompleted;
}

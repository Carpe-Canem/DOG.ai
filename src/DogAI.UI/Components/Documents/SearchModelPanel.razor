@* Which document search model is used and whether it is in memory. It is picked in Models › On this PC › Chat models › Default models. *@
@implements IDisposable
@inject EmbeddingServer Search
@inject DocumentLibrary Library

<div class="panel" id="search-model">
    <h4>Document search model</h4>
    @if (_path is null)
    {
        <p class="small">None yet. Documents can be added, but they are searched only once there is one.</p>
        <p class="small">Get one in <a class="link-text" href="@ModelsPlaces.Address(ModelsPlaces.Recommended)">@ModelsPlaces.RecommendedName</a>, under Document search (about 0.6 GB).</p>
    }
    else
    {
        <div class="kv"><span>Model</span><span>@Path.GetFileNameWithoutExtension(_path)</span></div>
        <div class="kv"><span>State</span><span id="search-model-state" data-state="@StateId">@State</span></div>
        <p class="small">It loads when a search or a new document needs it, and leaves memory after two minutes unused.<InfoButton About="the document search model">It runs beside the chat model and takes some graphics memory while it is in. It also leaves at once when a chat model or a picture needs the room, but never while documents are being indexed or searched. To use another, pick it in <a href="@ModelsPlaces.Address(ModelsPlaces.Library)">@ModelsPlaces.LibraryName › Default models</a>; documents are then indexed again.</InfoButton></p>
    }
    @if (Search.Error is { } error)
    {
        <div class="notice bad"><span>@error</span></div>
    }
    @if (Library.Progress is { } p)
    {
        <p class="small">Indexing @p.FileName: @p.Done of @p.Total passages.</p>
    }
</div>

@code {
    private string? _path;

    private string StateId => Search.IsStarting ? "loading" : !Search.IsRunning ? "out" : Library.IsIndexing ? "indexing" : "in";

    private string State => StateId switch
    {
        "loading" => "Loading…",
        "indexing" => "In memory, indexing documents",
        "in" => "In memory",
        _ => "Not in memory (loads when needed)",
    };

    protected override async Task OnInitializedAsync()
    {
        Search.Changed += Refresh;
        Library.Changed += Refresh;
        _path = await Search.ModelPathAsync();
    }

    private void Refresh() => InvokeAsync(async () =>
    {
        _path = await Search.ModelPathAsync();
        StateHasChanged();
    });

    public void Dispose()
    {
        Search.Changed -= Refresh;
        Library.Changed -= Refresh;
    }
}

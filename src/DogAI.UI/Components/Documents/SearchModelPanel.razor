@* Which document search model is used and whether it is running. It is picked in Models › On this PC › Chat models › Default models. *@
@implements IDisposable
@inject EmbeddingServer Search
@inject DocumentLibrary Library

<div class="panel">
    <h4>Document search model</h4>
    @if (_path is null)
    {
        <p class="small">None yet. Documents can be added, but they are searched only once there is one.</p>
        <p class="small">Get one in <a class="link-text" href="@ModelsPlaces.Address(ModelsPlaces.Recommended)">@ModelsPlaces.RecommendedName</a>, under Document search (about 0.6 GB).</p>
    }
    else
    {
        <div class="kv"><span>Model</span><span>@Path.GetFileNameWithoutExtension(_path)</span></div>
        <div class="kv"><span>State</span><span>@State</span></div>
        <p class="small">Starts when needed, stops after ten idle minutes.<InfoButton About="the document search model">It runs beside the chat model. To use another, pick it in <a href="@ModelsPlaces.Address(ModelsPlaces.Library)">@ModelsPlaces.LibraryName › Default models</a>; documents are then indexed again.</InfoButton></p>
    }
    @if (Search.Error is { } error)
    {
        <div class="notice bad"><span>@error</span></div>
    }
    @if (Library.Progress is { } p)
    {
        <p class="small">Indexing @p.FileName: @p.Done of @p.Total passages.</p>
    }
</div>

@code {
    private string? _path;

    private string State => Search.IsStarting ? "Starting…" : Search.IsRunning ? "Running" : "Stopped (starts when needed)";

    protected override async Task OnInitializedAsync()
    {
        Search.Changed += Refresh;
        Library.Changed += Refresh;
        _path = await Search.ModelPathAsync();
    }

    private void Refresh() => InvokeAsync(async () =>
    {
        _path = await Search.ModelPathAsync();
        StateHasChanged();
    });

    public void Dispose()
    {
        Search.Changed -= Refresh;
        Library.Changed -= Refresh;
    }
}

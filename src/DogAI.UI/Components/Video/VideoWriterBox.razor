@* "Write it for me…" on the Video section's Make tab (M21 step 4), modelled on the Images helper (PromptHelperBox): the
   chat model writes the clip's sentence from a few words of the owner's (VideoWriter.FromWordsAsync), or by looking at
   the first frame held (FromFrameAsync), with the owner's words on what should happen if any. The frame is made into
   the same 1,024-pixel JPEG a chat picture is (attach.js bytesToJpeg; the chat engine does not read WebP, and Better's
   frame is larger than 1,024), made plain and checked, and held only for that one request. The words, the choice and
   the sentence written live in VideoSession (memory only); the sentence goes into the box only when the owner presses
   Use this sentence. Nothing here is written anywhere or logged. Closing the dialog stops the job. *@
@implements IAsyncDisposable
@inject VideoWriter Writer
@inject ModelLauncher Launcher
@inject EngineManager Engine
@inject ISettingsStore SettingsStore
@inject VideoSession Session
@inject IJSRuntime JS

<Modal Title="Write it for me" Class="wide writer-box video-writer-box" OnClose="OnClose">
    <div class="writer" id="video-writer">
        <div class="seg writer-from" role="group" aria-label="Start from">
            <button type="button" id="video-writer-from-words" class="@(Session.HelperFromFrame ? "" : "active")" aria-pressed="@(Session.HelperFromFrame ? "false" : "true")"
                    disabled="@Working" @onclick="() => Session.HelperFrom(false)">From words</button>
            <button type="button" id="video-writer-from-frame" class="@(Session.HelperFromFrame ? "active" : "")" aria-pressed="@(Session.HelperFromFrame ? "true" : "false")"
                    disabled="@Working" @onclick="() => Session.HelperFrom(true)">From the first frame</button>
        </div>
        @if (Session.HelperFromFrame)
        {
            <div class="writer-picture" id="video-writer-frame">
                @if (Session.Frame is not null)
                {
                    <img id="video-writer-frame-thumb" src="@Session.Frame.Src" alt="The first frame the model looks at" width="@Session.Frame.Width" height="@Session.Frame.Height" />
                    <div class="writer-picture-facts">
                        <span id="video-writer-frame-from">From @Session.Frame.From · @Session.Frame.Width × @Session.Frame.Height</span>
                    </div>
                }
                else
                {
                    <p class="small writer-picture-none" id="video-writer-frame-none">@VideoWriting.NoFrame</p>
                }
            </div>
            <p class="small" id="video-writer-frame-about">@VideoWriting.FrameAbout</p>
            @if (Session.Frame is not null && CannotSee() is { } blind)
            {
                <div class="notice" id="video-writer-sees"><span>@blind.Text <a class="link-text" href="@blind.Address">@blind.PlaceName</a>.</span></div>
            }
        }
        <label class="field-block">
            <span class="field-label">@(Session.HelperFromFrame ? "What should happen (optional)" : "What the clip should show")</span>
            <textarea class="field" id="video-writer-words" rows="3" maxlength="@VideoWriter.MaxWordsLength" disabled="@Working"
                      placeholder="@(Session.HelperFromFrame ? "e.g. he turns his head to the fire" : "e.g. a lighthouse on a cliff in a storm, big waves")"
                      value="@Session.HelperWords" @oninput="e => Session.HelperSay(e.Value?.ToString() ?? string.Empty)" @onkeydown="KeyAsync"></textarea>
        </label>
        <p class="small" id="video-writer-about">
            @VideoWriting.About (<a class="link-text" href="@ModelsPlaces.Address(ModelsPlaces.Library)">@ModelsPlaces.LibraryName</a>)
        </p>
        <div class="row writer-row">
            @if (Working)
            {
                <button class="btn" id="video-writer-stop" @onclick="Stop">Stop</button>
            }
            else
            {
                <button class="btn primary" id="video-writer-write" disabled="@(WriteBlocked is not null)"
                        title="@(WriteBlocked ?? (Session.HelperFromFrame ? "The model looks at the first frame" : "Ctrl+Enter"))" @onclick="WriteAsync">@(Session.HelperDraft is null ? "Write it" : "Write it again")</button>
            }
            <span class="small" id="video-writer-status" role="status">@(Blocked ?? _status)</span>
        </div>
        @if (_error is { } error)
        {
            <div class="notice bad" id="video-writer-error"><span>@error</span></div>
        }
        @if (Session.HelperDraft is { } draft)
        {
            <div class="writer-result">
                <p class="writer-text" id="video-writer-result">@draft.Sentence</p>
                <p class="small" id="video-writer-parts">Seen: @draft.Seen · Moves: @draft.Moves · Camera: @draft.Camera</p>
                <div class="row">
                    <button class="btn primary" id="video-writer-use" disabled="@(Blocked is not null)" title="In place of the sentence in the box" @onclick="UseAsync">Use this sentence</button>
                </div>
                <p class="small">It replaces the sentence in the box, where you can change it before you press Draw.</p>
            </div>
        }
    </div>
</Modal>

@code {
    /// <summary>Why the model cannot be asked now (a clip being made), or null.</summary>
    [Parameter] public string? Blocked { get; set; }

    /// <summary>The sentence the owner chose: it replaces the box.</summary>
    [Parameter] public EventCallback<string> OnUse { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private CancellationTokenSource? _cts;
    private string? _status, _error;
    private IJSObjectReference? _module;

    /// <summary>The General default's name when no model is in memory and it cannot see (read once on open), else null.</summary>
    private string? _blindDefault;

    private bool Working => _cts is not null;

    /// <summary>Why Write cannot be pressed now, or null.</summary>
    private string? WriteBlocked =>
        Blocked
        ?? (Session.HelperFromFrame
            ? Session.Frame is null ? VideoWriting.NoFrame : CannotSee() is { } blind ? blind.Text + " " + blind.PlaceName + "." : null
            : string.IsNullOrWhiteSpace(Session.HelperWords) ? VideoWriting.SayFirst : null);

    /// <summary>
    /// The model that would look cannot see: the one in memory (the engine's own word), else the General default (by its
    /// file: no picture input beside it). Null when it can, or when that is not known yet (a model loading).
    /// </summary>
    private PlaceLine? CannotSee() =>
        Engine.IsReady ? (Engine.SeesPictures ? null : FromPicture.CannotSee(null))
        : Engine.State == EngineState.Loading ? null
        : _blindDefault is { } name ? FromPicture.CannotSee(name)
        : null;

    protected override async Task OnInitializedAsync()
    {
        Engine.Changed += Refresh;
        Session.Changed += Refresh;
        var settings = await SettingsStore.LoadAsync();
        if (ModelDefaults.For(settings, "general") is { } general && File.Exists(general))
            _blindDefault = await Task.Run(() => ModelProjector.Find(general) is null ? Path.GetFileNameWithoutExtension(general) : null);
    }

    private void Refresh() => _ = InvokeAsync(StateHasChanged);

    private async Task KeyAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && e.CtrlKey && !Working && WriteBlocked is null) await WriteAsync();
    }

    private async Task WriteAsync()
    {
        if (Working || WriteBlocked is not null) return;
        var frame = Session.HelperFromFrame ? Session.Frame : null;
        var words = Session.HelperWords;
        _error = null;
        var cts = new CancellationTokenSource();
        _cts = cts;
        try
        {
            // The frame as the model is shown it: the 1,024-pixel JPEG made in the page, held for this request only.
            byte[]? jpeg = null;
            if (frame is not null)
            {
                _status = "Getting the first frame ready…";
                StateHasChanged();
                jpeg = await JpegOfAsync(frame);
                if (jpeg is null || AttachedPictures.Problem(jpeg) is not null)
                {
                    _error = "The first frame cannot be shown to the model. " + (jpeg is null ? "It could not be read." : AttachedPictures.Problem(jpeg));
                    _status = null;
                    return;
                }
            }
            if (!Engine.IsReady)
            {
                _status = "Loading the chat model…";
                StateHasChanged();
                bool ready;
                try
                {
                    // Waits for a model a page is already loading, else loads the default for General; never a swap.
                    ready = await Launcher.EnsureReadyAsync(await SettingsStore.LoadAsync(), "general", cts.Token);
                }
                catch (ModelRefusedException e)
                {
                    _error = e.Message;
                    _status = null;
                    return;
                }
                if (!ready)
                {
                    _error = "No chat model is loaded, and none is set as the default for General. Choose one in " + ModelsPlaces.LibraryName + ", or load one with the model button in General, then try again.";
                    _status = null;
                    return;
                }
            }
            cts.Token.ThrowIfCancellationRequested();
            // The engine's own word, once the model is in: picture input that failed to load leaves it blind.
            if (jpeg is not null && !Engine.SeesPictures)
            {
                var blind = FromPicture.CannotSee(null);
                _error = blind.Text + " " + blind.PlaceName + ".";
                _status = null;
                return;
            }
            _status = VideoWriting.Working(Engine.IsLoaded, jpeg is not null);
            StateHasChanged();
            var draft = jpeg is null
                ? await Writer.FromWordsAsync(words, cts.Token)
                : await Writer.FromFrameAsync(jpeg, words, cts.Token);
            Session.HelperWrote(draft, fromFrame: jpeg is not null);
            _status = null;
        }
        catch (OperationCanceledException)
        {
            _status = "Stopped.";
        }
        catch (Exception e) when (e is InvalidOperationException or EngineException or JSException)
        {
            _error = e.Message;
            _status = null;
        }
        finally
        {
            if (ReferenceEquals(_cts, cts)) _cts = null;
            cts.Dispose();
        }
    }

    private void Stop() => _cts?.Cancel();

    private async Task<byte[]?> JpegOfAsync(VideoFrame frame)
    {
        _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./_content/DogAI.UI/js/attach.js");
        var bytes = await _module.InvokeAsync<byte[]?>("bytesToJpeg", frame.Bytes, AttachedPictures.MaxSide, AttachedPictures.Quality, ComposerPictures.MaxFileBytes);
        // The browser's encoder may add a colour profile: only that is taken out (anything else is refused).
        return bytes is { Length: > 0 } ? AttachedPictures.Plain(bytes) : null;
    }

    private async Task UseAsync()
    {
        if (Session.HelperDraft is not { } draft || Blocked is not null) return;
        await OnUse.InvokeAsync(draft.Sentence);
    }

    public async ValueTask DisposeAsync()
    {
        Engine.Changed -= Refresh;
        Session.Changed -= Refresh;
        // Closing the dialog (or leaving the Make tab) stops the job.
        _cts?.Cancel();
        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (Exception e) when (e is JSDisconnectedException or ObjectDisposedException)
            {
            }
        }
    }
}

<nav class="rail" aria-label="Main">
    <Logo />
    <div class="nav"><NavButtons /></div>
    <div class="rail-foot">
        <PlaceButton Place="@ReturnPlace.Search" Name="Search" Tip="Search (Ctrl+K jumps to a chat, character, story or setting)" />
        <PlaceButton Place="@ReturnPlace.Settings" Name="Settings" />
        <OfflineBadge />
    </div>
</nav>
<section class="list"><SectionOutlet SectionName="list" /></section>
<section class="center">
    <header class="head"><SectionOutlet SectionName="title" /></header>
    <div class="main">@ChildContent</div>
    <div class="composer-wrap"><SectionOutlet SectionName="composer" /></div>
    <footer class="status"><EngineStatus /></footer>
</section>
<aside class="aside"><SectionOutlet SectionName="aside" /></aside>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
}

@inherits LayoutComponentBase
@implements IDisposable
@inject AppearanceState Appearance
@inject NavigationManager Nav
@inject SidePanelDrawer Drawer
@inject ReturnPlace Return

@* Pages fill named regions (title, list, composer, aside) plus the body; the active skin decides where they go. *@
<div class="@ShellClass" data-theme="@Appearance.EffectiveTheme" data-screen="@Screen">
    <CascadingValue Name="Screen" Value="@Screen">
        @switch (Appearance.Skin)
        {
            case Skins.Fireside:
                <FiresideShell>@Body</FiresideShell>
                break;
            case Skins.Playhouse:
                <PlayhouseShell>@Body</PlayhouseShell>
                break;
            default:
                <WorkbenchShell>@Body</WorkbenchShell>
                break;
        }
    </CascadingValue>
    <LinkGuard />
    <LockKey />
    <JumpBox />
    <AsideDrawer />
</div>

@code {
    private string ShellClass => $"shell skin-{Appearance.Skin}{(Drawer.Open ? " drawer-open" : "")}";

    /// <summary>First segment of the current route, or "home" at the root.</summary>
    private string Screen
    {
        get
        {
            var first = Nav.ToBaseRelativePath(Nav.Uri).Split('/', '?', '#')[0];
            return first.Length == 0 ? "home" : first;
        }
    }

    protected override void OnInitialized()
    {
        Appearance.Changed += Refresh;
        Drawer.Changed += Refresh;
        Nav.LocationChanged += OnLocationChanged;
        // The first address raises no LocationChanged: remember it too, so Settings can go back to it.
        Return.Visited(Nav.ToBaseRelativePath(Nav.Uri));
    }

    private void Refresh() => InvokeAsync(StateHasChanged);

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        Return.Visited(Nav.ToBaseRelativePath(e.Location));
        Refresh();
    }

    public void Dispose()
    {
        Appearance.Changed -= Refresh;
        Drawer.Changed -= Refresh;
        Nav.LocationChanged -= OnLocationChanged;
    }
}

<header class="top">
    <div class="brand"><Logo /><span class="word">DOG<span class="ai">.ai</span></span></div>
    <nav class="nav" aria-label="Main"><NavButtons /></nav>
    <div class="top-tools">
        <OfflineBadge />
        <NavLink class="nav-btn" href="search" aria-label="Search" title="Search"><Icon Name="search" /><span>Search</span></NavLink>
        <NavLink class="nav-btn" href="settings" aria-label="Settings" title="Settings"><Icon Name="settings" /><span>Settings</span></NavLink>
    </div>
</header>
<div class="body">
    <section class="list"><SectionOutlet SectionName="list" /></section>
    <section class="center">
        <header class="head"><SectionOutlet SectionName="title" /></header>
        <div class="main">@ChildContent</div>
        <div class="composer-wrap"><SectionOutlet SectionName="composer" /></div>
    </section>
    <aside class="aside"><SectionOutlet SectionName="aside" /></aside>
</div>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
}

<?xml version="1.0" encoding="utf-8"?>
<!--
  Publishes DOG.ai straight into D:\DOG-AI, the folder that already holds the models (D:\DOG-AI\Models).

  In Visual Studio 2022: right-click DogAI.App > Publish..., pick "D-DOG-AI" in the profile list, press Publish.
  From a terminal in the repository folder:

      dotnet publish src/DogAI.App -p:PublishProfile=D-DOG-AI

  Same build as win-x64 (self-contained, Windows 64-bit, ReadyToRun), only the destination differs.

  The copy is portable (it ships portable.txt), so once it runs it keeps everything in its own folder:
    D:\DOG-AI\DogAI.exe   the app
    D:\DOG-AI\Models      models (Windows treats "models" and "Models" as the same folder, so the existing one is used)
    D:\DOG-AI\data        chats, settings, logs, the model engine
  It does not read %LOCALAPPDATA%\DOG-AI; bring older chats over with Settings > Backup and Restore.

  Publishing again only overwrites the app's own files. DeleteExistingFiles stays false so that Models and data
  are never wiped. Close DOG.ai first, or Windows will refuse to replace files that are in use.
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <TargetFramework>net9.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishReadyToRun>true</PublishReadyToRun>
    <DebugType>none</DebugType>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <PublishProtocol>FileSystem</PublishProtocol>
    <_TargetId>Folder</_TargetId>
    <DeleteExistingFiles>false</DeleteExistingFiles>
    <PublishDir>D:\DOG-AI\</PublishDir>
  </PropertyGroup>
</Project>

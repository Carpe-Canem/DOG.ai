<?xml version="1.0" encoding="utf-8"?>
<!--
  Publishes DOG.ai straight into D:\DOG.ai, the folder that holds the models (D:\DOG.ai\Models).
  If the folder is still called D:\DOG-AI, rename it to D:\DOG.ai first (close DOG.ai; the first start after that
  updates the saved paths itself). Publishing before that would create a second, empty install.

  In Visual Studio 2022: right-click DogAI.App > Publish..., pick "D-DOGai" in the profile list, press Publish.
  From a terminal in the repository folder:

      dotnet publish src/DogAI.App -p:PublishProfile=D-DOGai

  Same build as win-x64 (self-contained, Windows 64-bit, ReadyToRun), only the destination differs.

  The copy is portable (it ships portable.txt), so once it runs it keeps everything in its own folder:
    D:\DOG.ai\DOG.ai.exe   a small launcher that starts the app
    D:\DOG.ai\app         the program files (everything else the app needs)
    D:\DOG.ai\Models      models (Windows treats "models" and "Models" as the same folder, so the existing one is used)
    D:\DOG.ai\data        chats, settings, logs, the model engine
  It does not read %LOCALAPPDATA%\DOG.ai; bring older chats over with Settings > Backup and Restore.

  Publishing again empties D:\DOG.ai\app and refills it (the build refuses to empty any folder not named "app"), so old files
  never pile up and Models and data are never touched. Close DOG.ai first, or Windows will refuse to replace files in use.
  An install made before this layout (program files loose in D:\DOG-AI) is converted once with tools\tidy-install.ps1.
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishReadyToRun>true</PublishReadyToRun>
    <DebugType>none</DebugType>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <PublishProtocol>FileSystem</PublishProtocol>
    <_TargetId>Folder</_TargetId>
    <DeleteExistingFiles>false</DeleteExistingFiles>
    <PublishDir>D:\DOG.ai\app\</PublishDir>
  </PropertyGroup>
</Project>

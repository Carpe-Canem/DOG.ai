<?xml version="1.0" encoding="utf-8"?>
<!--
  Self-contained build for Windows 64-bit: the .NET runtime is included, so the PC needs nothing installed (only the WebView2
  runtime that Windows 11 already has). Run from the repository folder:

      dotnet publish src/DogAI.App -p:PublishProfile=win-x64

  The result is in publish\win-x64: DogAI.exe (a small launcher), portable.txt and app\ (the program). Because the runtime identifier is win-x64, NuGet packages keep only their Windows 64-bit
  native files (the voice libraries ship Linux, macOS and ARM files too, which are left out).
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishReadyToRun>true</PublishReadyToRun>
    <DebugType>none</DebugType>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <PublishDir>$(MSBuildThisFileDirectory)..\..\..\..\publish\win-x64\app\</PublishDir>
  </PropertyGroup>
</Project>

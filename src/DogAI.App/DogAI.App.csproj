<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Only for the notification-area icon; the window is WPF. -->
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>DogAI.App</RootNamespace>
    <AssemblyName>DogAI</AssemblyName>
    <Product>DOG.ai</Product>
    <Version>0.1.0</Version>
    <ApplicationIcon>Assets\dogai.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- WinForms and WPF both define Application, MessageBox and more; the code here means WPF's. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DogAI.Core\DogAI.Core.csproj" />
    <ProjectReference Include="..\DogAI.Data\DogAI.Data.csproj" />
    <ProjectReference Include="..\DogAI.Engine\DogAI.Engine.csproj" />
    <ProjectReference Include="..\DogAI.Hub\DogAI.Hub.csproj" />
    <ProjectReference Include="..\DogAI.UI\DogAI.UI.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Wpf" Version="9.0.120" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="9.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

  <!--
    The voice packages (Whisper.net) ship native libraries for every platform. A publish keeps only what this app can use: Windows
    64-bit, with the Vulkan one for the graphics card. Nothing here changes a normal build.
  -->
  <Target Name="PruneForeignNativeFiles" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ForeignNative Include="@(ResolvedFileToPublish)"
                     Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('%(ResolvedFileToPublish.RelativePath)', '^runtimes[\/]([a-z]+[\/])?(linux|macos|osx|android|ios|win-arm|win-x86)|^ggml-metal|\.pdb$'))" />
      <ResolvedFileToPublish Remove="@(ForeignNative)" />
    </ItemGroup>
  </Target>

</Project>
